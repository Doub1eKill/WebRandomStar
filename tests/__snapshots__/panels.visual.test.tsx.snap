-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-upload" aria-hidden="true"><path d="M12 3v12"></path><path d="m17 8-5-5-5 5"></path><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path></svg> Import JSON<input type="file" accept=".json" style="display:none"/></label><button disabled="" title="ยังไม่มีคำถามที่ใช้แล้ว" style="display:flex;align-items:center;gap:0.35rem;padding:0.55rem 0.8rem;background:rgba(234, 179, 8, 0.1);border:1px solid rgba(234, 179, 8, 0.35);border-radius:8px;color:#facc15;font-size:0.85rem;cursor:not-allowed;opacity:0.45"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-ccw" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg> รีเซ็ตคำถามที่ใช้แล้ว (<!-- -->0<!-- -->)</button></div></div><div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;font-size:0.8rem"><span style="color:#64748b;display:flex;align-items:center;gap:0.25rem"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-funnel lucide-filter" aria-hidden="true"><path d="M10 20a1 1 0 0 0 .553.895l2 1A1 1 0 0 0 14 21v-7a2 2 0 0 1 .517-1.341L21.74 4.67A1 1 0 0 0 21 3H3a1 1 0 0 0-.742 1.67l7.225 7.989A2 2 0 0 1 10 14z"></path></svg> ตัวกรอง:</span><select class="ui-select-compact"><option value="all" selected="">ทุกรอบ</option><option value="attitude">attitude</option><option value="general">general</option><option value="intro">intro</option><option value="scenario">scenario</option><option value="final">final</option></select><select class="ui-select-compact"><option value="all" selected="">ทุกระดับความยาก</option><option value="easy">Easy (ง่าย)</option><option value="medium">Medium (ปานกลาง)</option><option value="hard">Hard (ท้าทาย)</option></select><select class="ui-select-compact"><option value="all" selected="">ทุกสถานะ</option><option value="enabled">เปิดใช้งาน (Enabled)</option><option value="disabled">ปิดใช้งาน (Disabled)</option><option value="unused">ยังไม่เคยใช้ (Unused)</option><option value="used">ใช้แล้ว (Used)</option></select><span style="margin-left:auto;color:#94a3b8">พบ <!-- -->42<!-- --> / <!-- -->42<!-- --> ข้อ</span></div><div style="overflow-x:auto;border:1px solid rgba(255, 255, 255, 0.08);border-radius:10px;background:rgba(14, 18, 44, 0.4)"><table style="width:100%;border-collapse:collapse;text-align:left;font-size:0.85rem"><thead><tr style="border-bottom:1px solid rgba(255, 255, 255, 0.1);background:rgba(255, 255, 255, 0.02);color:#94a3b8"><th style="padding:0.75rem 1rem;width:90px">ID</th><th style="padding:0.75rem 1rem">ข้อความคำถาม</th><th style="padding:0.75rem 1rem;width:80px">ระดับ</th><th style="padding:0.75rem 1rem;width:90px">รอบ</th><th style="padding:0.75rem 1rem;width:90px;text-align:center">สถานะ</th><th style="padding:0.75rem 1rem;width:130px;text-align:right">จัดการ</th></tr></thead><tbody><tr style="border-bottom:1px solid rgba(255, 255, 255, 0.04);background:transparent;opacity:1"><td style="padding:0.75rem 1rem;font-family:monospace;color:#94a3b8;font-size:0.8rem">Q_RAIN_01</td><td style="padding:0.75rem 1rem;color:#f1f5f9;line-height:1.4">ในยุคที่โลกและสังคมเปลี่ยนแปลงอย่างรวดเร็ว คุณคิดว่า &quot;เสน่ห์&quot; ของการเป็นผู้นำที่พร้อมปรับตัวรับมือกับความไม่แน่นอนคืออะไร?</td><td style="padding:0.75rem 1rem;color:#94a3b8;text-transform:capitalize">medium</td><td style="padding:0.75rem 1rem;color:#94a3b8">attitude</td><td style="padding:0.75rem 1rem;text-align:center"><button style="background:none;border:none;cursor:pointer;color:#22c55e;display:inline-flex;align-items:center;gap:0.2rem;font-size:0.75rem"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check-big lucide-check-circle" aria-hidden="true"><path d="M21.801 10A10 10 0 1 1 17 3.335"></path><path d="m9 11 3 3L22 4"></path></svg><span>เปิด</span></button></td><td style="padding:0.75rem 1rem;text-align:right"><div style="display:inline-flex;gap:0.15rem"><button title="ดูตัวอย่าง (เฉพาะหลังเวที)" style="background:none;border:none;color:#38bdf8;cursor:pointer;padding:0.45rem;border-radius:8px;display:inline-flex"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle></svg></button><button title="แก้ไข" style="background:none;border:none;color:#a855f7;cursor:pointer;padding:0.45rem;border-radius:8px;display:inline-flex"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pen lucide-edit-2" aria-hidden="true"><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"></path></svg></button><button title="คัดลอก" style="background:none;border:none;color:#cbd5e1;cursor:pointer;padding:0.45rem;border-radius:8px;display:inline-flex"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path><