ight="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle></svg></button><button title="แก้ไข" style="background:none;border:none;color:#a855f7;cursor:pointer;padding:0.45rem;border-radius:8px;display:inline-flex"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pen lucide-edit-2" aria-hidden="true"><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"></path></svg></button><button title="คัดลอก" style="background:none;border:none;color:#cbd5e1;cursor:pointer;padding:0.45rem;border-radius:8px;display:inline-flex"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg></button><button title="ลบ" style="background:none;border:none;color:#ef4444;cursor:pointer;padding:0.45rem;border-radius:8px;display:inline-flex"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash lucide-trash-2" aria-hidden="true"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button></div></td></tr><tr style="border-bottom:1px solid rgba(255, 255, 255, 0.04);background:transparent;opacity:1"><td style="padding:0.75rem 1rem;font-family:monospace;color:#94a3b8;font-size:0.8rem">Q_LEAF_06</td><td style="padding:0.75rem 1rem;color:#f1f5f9;line-height:1.4">สิ่งที่คุณอยากทิ้งไว้เป็นรอยจารึกหรือประโยชน์แก่รุ่นน้องก่อนสำเร็จการศึกษาจากที่นี่คืออะไร?</td><td style="padding:0.75rem 1rem;color:#94a3b8;text-transform:capitalize">medium</td><td style="padding:0.75rem 1rem;color:#94a3b8">attitude</td><td style="padding:0.75rem 1rem;text-align:center"><button style="background:none;border:none;cursor:pointer;color:#22c55e;display:inline-flex;align-items:center;gap:0.2rem;font-size:0.75rem"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check-big lucide-check-circle" aria-hidden="true"><path d="M21.801 10A10 10 0 1 1 17 3.335"></path><path d="m9 11 3 3L22 4"></path></svg><span>เปิด</span></button></td><td style="padding:0.75rem 1rem;text-align:right"><div style="display:inline-flex;gap:0.15rem"><button title="ดูตัวอย่าง (เฉพาะหลังเวที)" style="background:none;border:none;color:#38bdf8;cursor:pointer;padding:0.45rem;border-radius:8px;display:inline-flex"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle></svg></button><button title="แก้ไข" style="background:none;border:none;color:#a855f7;cursor:pointer;padding:0.45rem;border-radius:8px;display:inline-flex"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pen lucide-edit-2" aria-hidden="true"><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"></path></svg></button><button title="คัดลอก" style="background:none;border:none;color:#cbd5e1;cursor:pointer;padding:0.45rem;border-radius:8px;display:inline-flex"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg></button><button title="ลบ" style="background:none;border:none;color:#ef4444;cursor:pointer;padding:0.45rem;border-radius:8px;display:inline-flex"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash lucide-trash-2" aria-hidden="true"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button></div></td></tr><tr style="border-bottom:1px solid rgba(255, 255, 255, 0.04);background:transparent;opacity:1"><td style="padding:0.75rem 1rem;font-family:monospace;color:#94a3b8;font-size:0.8rem">Q_MOON_01</td><td style="padding:0.75rem 1rem;color:#f1f5f9;line-height:1.4">ในสังคมที่ทุกคนต่างนำเสนอความสมบูรณ์แบบบนโลกออนไลน์ คุณรักษา &quot;ความเป็นตัวของตัวเอง&quot; (Authenticity) ไว้อย่างไรให้ทรงคุณค่าที่สุด?</td><td style="padding:0.75rem 1rem;color:#94a3b8;text-transform:capitalize">medium</td><td style="padding:0.75rem 1rem;color:#94a3b8">attitude</td><td style="padding:0.75rem 1rem;text-align:center"><button style="background:none;border:none;cursor:pointer;color:#22c55e;display:inline-flex;align-items:center;gap:0.2rem;font-size:0.75rem"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check-big lucide-check-circle" aria-hidden="true"><path d="M21.801 10A10 10 0 1 1 17 3.335"></path><path d="m9 11 3 3L22 4"></path></svg><span>เปิด</span></button></td><td style="padding:0.75rem 1rem;text-align:right"><div style="display:inline-flex;gap:0.15rem"><button title="ดูตัวอย่าง (เฉพาะหลังเวที)" style="background:none;border:none;color:#38bdf8;cursor:pointer;padding:0.45rem;border-radius:8px;display:inline-flex"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle></svg></button><button title="แก้ไข" style="background:none;border:none;color:#a855f7;cursor:pointer;padding:0.45rem;border-radius:8px;display:inline-flex"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pen lucide-edit-2" aria-hidden="true"><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"></path></svg></button><button title="คัดลอก" style="background:none;border:none;color:#cbd5e1;cursor:pointer;padding:0.45rem;border-radius:8px;display:inline-flex"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg></button><button title="ลบ" style="background:none;border:none;color:#ef4444;cursor:pointer;padding:0.45rem;border-radius:8px;display:inline-flex"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash lucide-trash-2" aria-hidden="true"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button></div></td></tr><tr style="border-bottom:1px solid rgba(255, 255, 255, 0.04);background:rgba(239, 68, 68, 0.02);opacity:0.6"><td style="padding:0.75rem 1rem;font-family:monospace;color:#94a3b8;font-size:0.8rem">Q_MOON_02</td><td style="padding:0.75rem 1rem;color:#f1f5f9;line-height:1.4">ความเข้าอกเข้าใจผู้อื่น (Empathy) มีพลังในการเยียวยาและสร้างการเปลี่ยนแปลงให้แก่สังคมในมิติใดได้บ้าง?</td><td style="padding:0.75rem 1rem;color:#94a3b8;text-transform:capitalize">hard</td><td style="padding:0.75rem 1rem;color:#94a3b8">scenario</td><td style="padding:0.75rem 1rem;text-align:center"><button style="background:none;border:none;cursor:pointer;color:#64748b;display:inline-flex;align-items:center;gap:0.2rem;font-size:0.75rem"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-x lucide-x-circle" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m15 9-6 6"></path><path d="m9 9 6 6"></path></svg><span>ปิด</span></button></td><td style="padding:0.75rem 1rem;text-align:right"><div style="display:inline-flex;gap:0.15rem"><button title="ดูตัวอย่าง (เฉพาะหลังเวที)" style="background:none;border:none;color:#38bdf8;cursor:pointer;padding:0.45rem;border-radius:8px;display:inline-flex"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle></svg></button><button title="แก้ไข" style="background:none;border:none;color:#a855f7;cursor:pointer;padding:0.45rem;border-radius:8px;display:inline-flex"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pen lucide-edit-2" aria-hidden="true"><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"></path></svg></button><button title="คัดลอก" style="background:none;border:none;color:#cbd5e1;cursor:pointer;padding:0.45rem;border-radius:8px;display:inline-flex"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg></button><button title="ลบ" style="background:none;border:none;color:#ef4444;cursor:pointer;padding:0.45rem;border-radius:8px;display:inline-flex"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash lucide-trash-2" aria-hidden="true"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button></div></td></tr><tr style="border-bottom:1px solid rgba(255, 255, 255, 0.04);background:transparent;opacity:1"><td style="padding:0.75rem 1rem;font-family:monospace;color:#94a3b8;font-size:0.8rem">Q_MOON_03</td><td style="padding:0.75rem 1rem;color:#f1f5f9;line-height:1.4">หากคุณประสบความสำเร็จในอาชีพการงานตามที่ฝันไว้ คุณจะตอบแทนสังคมหรือชุมชนที่คุณเติบโตมาอย่างไร?</td><td style="padding:0.75rem 1rem;color:#94a3b8;text-transform:capitalize">hard</td><td style="padding:0.75rem 1rem;color:#94a3b8">scenario</td><td style="padding:0.75rem 1rem;text-align:center"><button style="background:none;border:none;cursor:pointer;color:#22c55e;display:inline-flex;align-items:center;gap:0.2rem;font-size:0.75rem"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check-big lucide-check-circle" aria-hidden="true"><path d="M21.801 10A10 10 0 1 1 17 3.335"></path><path d="m9 11 3 3L22 4"></path></svg><span>เปิด</span></button></td><td style="padding:0.75rem 1rem;text-align:right"><div style="display:inline-flex;gap:0.15rem"><button title="ดูตัวอย่าง (เฉพาะหลังเวที)" style="background:none;border:none;color:#38bdf8;cursor:pointer;padding:0.45rem;border-radius:8px;display:inline-flex"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle></svg></button><button title="แก้ไข" style="background:none;border:none;color:#a855f7;cursor:pointer;padding:0.45rem;border-radius:8px;display:inline-flex"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pen lucide-edit-2" aria-hidden="true"><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"></path></svg></button><button title="คัดลอก" style="background:none;border:none;color:#cbd5e1;cursor:pointer;padding:0.45rem;border-radius:8px;display:inline-flex"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg></button><button title="ลบ" style="background:none;border:none;color:#ef4444;cursor:pointer;padding:0.45rem;border-radius:8px;display:inline-flex"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash lucide-trash-2" aria-hidden="true"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button></div></td></tr><tr style="border-bottom:1px solid rgba(255, 255, 255, 0.04);background:transparent;opacity:1"><td style="padding:0.75rem 1rem;font-family:monospace;color:#94a3b8;font-size:0.8rem">Q_MOON_04</td><td style="padding:0.75rem 1rem;color:#f1f5f9;line-height:1.4">ความสุขที่แท้จริงระหว่าง &quot;การไปถึงเป้าหมาย&quot; กับ &quot;ประสบการณ์ระหว่างทาง&quot; คุณให้น้ำหนักกับสิ่งใดมากกว่ากัน?</td><td style="padding:0.75rem 1rem;color:#94a3b8;text-transform:capitalize">medium</td><td style="padding:0.75rem 1rem;color:#94a3b8">attitude</td><td style="padding:0.75rem 1rem;text-align:center"><button style="background:none;border:none;cursor:pointer;color:#22c55e;display:inline-flex;align-items:center;gap:0.2rem;font-size:0.75rem"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check-big lucide-check-circle" aria-hidden="true"><path d="M21.801 10A10 10 0 1 1 17 3.335"></path><path d="m9 11 3 3L22 4"></path></svg><span>เปิด</span></button></td><td style="padding:0.75rem 1rem;text-align:right"><div style="display:inline-flex;gap:0.15rem"><button title="ดูตัวอย่าง (เฉพาะหลังเวที)" style="background:none;border:none;color:#38bdf8;cursor:pointer;padding:0.45rem;border-radius:8px;display:inline-flex"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle></svg></button><button title="แก้ไข" style="background:none;border:none;color:#a855f7;cursor:pointer;padding:0.45rem;border-radius:8px;display:inline-flex"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pen lucide-edit-2" aria-hidden="true"><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"></path></svg></button><button title="คัดลอก" style="background:none;border:none;color:#cbd5e1;cur