exports[`split panels render the same markup > QuestionBankDashboard (empty bank) 1`] = `"<div class="ui-panel-stack"><div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(130px, 1fr));gap:0.75rem"><div class="stat-card" style="background:rgba(255, 255, 255, 0.04);padding:0.9rem;border-radius:10px;border:1px solid rgba(255, 255, 255, 0.08)"><div class="ui-caption">คำถามทั้งหมด</div><div style="font-size:1.5rem;font-weight:700;color:#f8fafc">0</div></div><div class="stat-card" style="background:rgba(34, 197, 94, 0.06);padding:0.9rem;border-radius:10px;border:1px solid rgba(34, 197, 94, 0.2)"><div style="font-size:0.75rem;color:#86efac">เปิดใช้งาน (Enabled)</div><div style="font-size:1.5rem;font-weight:700;color:#22c55e">0</div></div><div class="stat-card" style="background:rgba(239, 68, 68, 0.06);padding:0.9rem;border-radius:10px;border:1px solid rgba(239, 68, 68, 0.2)"><div style="font-size:0.75rem;color:#fca5a5">ปิดใช้งาน (Disabled)</div><div style="font-size:1.5rem;font-weight:700;color:#ef4444">0</div></div><div class="stat-card" style="background:rgba(234, 179, 8, 0.06);padding:0.9rem;border-radius:10px;border:1px solid rgba(234, 179, 8, 0.2)"><div style="font-size:0.75rem;color:#fde047">ใช้ไปแล้ว (Used)</div><div style="font-size:1.5rem;font-weight:700;color:#eab308">0</div></div><div class="stat-card" style="background:rgba(56, 189, 248, 0.06);padding:0.9rem;border-radius:10px;border:1px solid rgba(56, 189, 248, 0.2)"><div style="font-size:0.75rem;color:#7dd3fc">คงเหลือ (Remaining)</div><div style="font-size:1.5rem;font-weight:700;color:#38bdf8">0</div></div></div><div style="display:flex;flex-wrap:wrap;gap:0.75rem;justify-content:space-between;align-items:center"><div style="position:relative;flex:1 1 240px;min-width:200px"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search" aria-hidden="true" style="position:absolute;left:0.75rem;top:50%;transform:translateY(-50%);color:#64748b"><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle></svg><input type="text" placeholder="ค้นหาข้อความ, ID หรือแท็ก..." style="width:100%;padding:0.55rem 0.75rem 0.55rem 2.25rem;background:rgba(14, 18, 44, 0.6);border:1px solid rgba(255, 255, 255, 0.12);border-radius:8px;color:#f8fafc;font-size:0.85rem" value=""/></div><div style="display:flex;gap:0.5rem;flex-wrap:wrap"><button style="display:flex;align-items:center;gap:0.35rem;padding:0.55rem 0.9rem;background:linear-gradient(135deg, var(--ctl-accent), var(--ctl-accent-2));border:none;border-radius:8px;color:#fff;font-size:0.85rem;font-weight:600;cursor:pointer"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg> เพิ่มคำถาม</button><button style="display:flex;align-items:center;gap:0.35rem;padding:0.55rem 0.8rem;background:rgba(255, 255, 255, 0.08);border:1px solid rgba(255, 255, 255, 0.15);border-radius:8px;color:#cbd5e1;font-size:0.85rem;cursor:pointer"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-download" aria-hidden="true"><path d="M12 15V3"></path><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><path d="m7 10 5 5 5-5"></path></svg> Export JSON</button><label style="display:flex;align-items:center;gap:0.35rem;padding:0.55rem 0.8rem;background:rgba(255, 255, 255, 0.08);border:1px solid rgba(255, 255, 255, 0.15);border-radius:8px;color:#cbd5e1;font-size:0.85rem;cursor:pointer"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-upload" aria-hidden="true"><path d="M12 3v12"></path><path d="m17 8-5-5-5 5"></path><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path></svg> Import JSON<input type="file" accept=".json" style="display:none"/></label><button disabled="" title="ยังไม่มีคำถามที่ใช้แล้ว" style="display:flex;align-items:center;gap:0.35rem;padding:0.55rem 0.8rem;background:rgba(234, 179, 8, 0.1);border:1px solid rgba(234, 179, 8, 0.35);border-radius:8px;color:#facc15;font-size:0.85rem;cursor:not-allowed;opacity:0.45"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-ccw" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg> รีเซ็ตคำถามที่ใช้แล้ว (<!-- -->0<!-- -->)</button></div></div><div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;font-size:0.8rem"><span style="color:#64748b;display:flex;align-items:center;gap:0.25rem"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-funnel lucide-filter" aria-hidden="true"><path d="M10 20a1 1 0 0 0 .553.895l2 1A1 1 0 0 0 14 21v-7a2 2 0 0 1 .517-1.341L21.74 4.67A1 1 0 0 0 21 3H3a1 1 0 0 0-.742 1.67l7.225 7.989A2 2 0 0 1 10 14z"></path></svg> ตัวกรอง:</span><select class="ui-select-compact"><option value="all" selected="">ทุกรอบ</option></select><select class="ui-select-compact"><option value="all" selected="">ทุกระดับความยาก</option><option value="easy">Easy (ง่าย)</option><option value="medium">Medium (ปานกลาง)</option><option value="hard">Hard (ท้าทาย)</option></select><select class="ui-select-compact"><option value="all" selected="">ทุกสถานะ</option><option value="enabled">เปิดใช้งาน (Enabled)</option><option value="disabled">ปิดใช้งาน (Disabled)</option><option value="unused">ยังไม่เคยใช้ (Unused)</option><option value="used">ใช้แล้ว (Used)</option></select><span style="margin-left:auto;color:#94a3b8">พบ <!-- -->0<!-- --> / <!-- -->0<!-- --> ข้อ</span></div><div style="overflow-x:auto;border:1px solid rgba(255, 255, 255, 0.08);border-radius:10px;background:rgba(14, 18, 44, 0.4)"><table style="width:100%;border-collapse:collapse;text-align:left;font-size:0.85rem"><thead><tr style="border-bottom:1px solid rgba(255, 255, 255, 0.1);background:rgba(255, 255, 255, 0.02);color:#94a3b8"><th style="padding:0.75rem 1rem;width:90px">ID</th><th style="padding:0.75rem 1rem">ข้อความคำถาม</th><th style="padding:0.75rem 1rem;width:80px">ระดับ</th><th style="padding:0.75rem 1rem;width:90px">รอบ</th><th style="padding:0.75rem 1rem;width:90px;text-align:center">สถานะ</th><th style="padding:0.75rem 1rem;width:130px;text-align:right">จัดการ</th></tr></thead><tbody><tr><td colSpan="6" style="text-align:center;padding:2.5rem;color:#64748b">ไม่พบคำถามที่ตรงกับเงื่อนไขการค้นหา</td></tr></tbody></table></div></div>"`;

exports[`split panels render the same markup > QuestionBankDashboard (some used and disabled) 1`] = `"<div class="ui-panel-stack"><div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(130px, 1fr));gap:0.75rem"><div class="stat-card" style="background:rgba(255, 255, 255, 0.04);padding:0.9rem;border-radius:10px;border:1px solid rgba(255, 255, 255, 0.08)"><div class="ui-caption">คำถามทั้งหมด</div><div style="font-size:1.5rem;font-weight:700;color:#f8fafc">42</div></div><div class="stat-card" style="background:rgba(34, 197, 94, 0.06);padding:0.9rem;border-radius:10px;border:1px solid rgba(34, 197, 94, 0.2)"><div style="font-size:0.75rem;color:#86efac">เปิดใช้งาน (Enabled)</div><div style="font-size:1.5rem;font-weight:700;color:#22c55e">33</div></div><div class="stat-card" style="background:rgba(239, 68, 68, 0.06);padding:0.9rem;border-radius:10px;border:1px solid rgba(239, 68, 68, 0.2)"><div style="font-size:0.75rem;color:#fca5a5">ปิดใช้งาน (Disabled)</div><div style="font-size:1.5rem;font-weight:700;color:#ef4444">9</div></div><div class="stat-card" style="background:rgba(234, 179, 8, 0.06);padding:0.9rem;border-radius:10px;border:1px solid rgba(234, 179, 8, 0.2)"><div style="font-size:0.75rem;color:#fde047">ใช้ไปแล้ว (Used)</div><div style="font-size:1.5rem;font-weight:700;color:#eab308">3</div></div><div class="stat-card" style="background:rgba(56, 189, 248, 0.06);padding:0.9rem;border-radius:10px;border:1px solid rgba(56, 189, 248, 0.2)"><div style="font-size:0.75rem;color:#7dd3fc">คงเหลือ (Remaining)</div><div style="font-size:1.5rem;font-weight:700;color:#38bdf8">30</div></div></div><div style="display:flex;flex-wrap:wrap;gap:0.75rem;justify-content:space-between;align-items:center"><div style="position:relative;flex:1 1 240px;min-width:200px"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-searc