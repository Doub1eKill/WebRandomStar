บบ"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash lucide-trash-2" aria-hidden="true"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button></div></div></div></div></div>"`;

exports[`split panels render the same markup > QuestionBankDashboard (all questions) 1`] = `"<div class="ui-panel-stack"><div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(130px, 1fr));gap:0.75rem"><div class="stat-card" style="background:rgba(255, 255, 255, 0.04);padding:0.9rem;border-radius:10px;border:1px solid rgba(255, 255, 255, 0.08)"><div class="ui-caption">คำถามทั้งหมด</div><div style="font-size:1.5rem;font-weight:700;color:#f8fafc">42</div></div><div class="stat-card" style="background:rgba(34, 197, 94, 0.06);padding:0.9rem;border-radius:10px;border:1px solid rgba(34, 197, 94, 0.2)"><div style="font-size:0.75rem;color:#86efac">เปิดใช้งาน (Enabled)</div><div style="font-size:1.5rem;font-weight:700;color:#22c55e">42</div></div><div class="stat-card" style="background:rgba(239, 68, 68, 0.06);padding:0.9rem;border-radius:10px;border:1px solid rgba(239, 68, 68, 0.2)"><div style="font-size:0.75rem;color:#fca5a5">ปิดใช้งาน (Disabled)</div><div style="font-size:1.5rem;font-weight:700;color:#ef4444">0</div></div><div class="stat-card" style="background:rgba(234, 179, 8, 0.06);padding:0.9rem;border-radius:10px;border:1px solid rgba(234, 179, 8, 0.2)"><div style="font-size:0.75rem;color:#fde047">ใช้ไปแล้ว (Used)</div><div style="font-size:1.5rem;font-weight:700;color:#eab308">0</div></div><div class="stat-card" style="background:rgba(56, 189, 248, 0.06);padding:0.9rem;border-radius:10px;border:1px solid rgba(56, 189, 248, 0.2)"><div style="font-size:0.75rem;color:#7dd3fc">คงเหลือ (Remaining)</div><div style="font-size:1.5rem;font-weight:700;color:#38bdf8">42</div></div></div><div style="display:flex;flex-wrap:wrap;gap:0.75rem;justify-content:space-between;align-items:center"><div style="position:relative;flex:1 1 240px;min-width:200px"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search" aria-h