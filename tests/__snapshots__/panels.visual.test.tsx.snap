exports[`split panels render the same markup > TimerPanel (critical) 1`] = `"<div class="ui-panel-stack"><div style="background:linear-gradient(135deg, rgba(56, 189, 248, 0.12), rgba(14, 18, 44, 0.75));border:1.5px solid rgba(255, 255, 255, 0.15);border-radius:16px;padding:1.5rem;text-align:center;box-shadow:0 8px 32px rgba(0, 0, 0, 0.35);transition:all 0.3s ease"><div style="display:flex;justify-content:center;align-items:center;gap:0.6rem;margin-bottom:0.5rem;flex-wrap:wrap"><span style="padding:0.25rem 0.75rem;border-radius:9999px;font-size:0.75rem;font-weight:700;text-transform:uppercase;background:rgba(234, 179, 8, 0.2);color:#fde047;border:1px solid rgba(255, 255, 255, 0.1)">paused</span></div><div style="font-family:&#x27;Outfit&#x27;, monospace, system-ui;font-size:4.2rem;font-weight:800;color:#f8fafc;letter-spacing:0.06em;margin:0.4rem 0;line-height:1">00:08</div><div style="height:6px;width:100%;max-width:340px;margin:0.75rem auto;background:rgba(255,255,255,0.1);border-radius:9999px;overflow:hidden"><div style="width:13.333333333333334%;height:100%;background:linear-gradient(90deg, #0284c7, #38bdf8);transition:width 0.18s linear"></div></div><div style="display:flex;justify-content:center;gap:0.6rem;margin-top:1.25rem;flex-wrap:wrap"><button style="display:inline-flex;align-items:center;gap:0.4rem;padding:0.75rem 1.6rem;background:linear-gradient(135deg, #22c55e, #16a34a);border:none;border-radius:10px;color:#fff;font-size:1rem;font-weight:700;cursor:pointer;box-shadow:0 4px 15px rgba(34, 197, 94, 0.35)"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-play" aria-hidden="true"><path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"></path></svg> <!-- -->นับต่อ (Resume)</button><button style="display:inline-flex;align-items:center;gap:0.4rem;padding:0.75rem 1.15rem;background:rgba(255, 255, 255, 0.08);border:1px solid rgba(255, 255, 255, 0.15);border-radius:10px;color:#cbd5e1;font-size:0.9rem;cursor:pointer"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-ccw" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg> รีเซ็ต (Reset)</button><button style="display:inline-flex;align-items:center;gap:0.4rem;padding:0.75rem 1.15rem;background:rgba(239, 68, 68, 0.15);border:1px solid rgba(239, 68, 68, 0.3);border-radius:10px;color:#fca5a5;font-size:0.9rem;cursor:pointer;opacity:1"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check lucide-check-circle-2" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m16 9-5.5 5.5L8 12"></path></svg> จบเวลา (Finish)</button></div><div style="margin-top:1.1rem;padding-top:1rem;border-top:1px solid rgba(255, 255, 255, 0.08);display:flex;align-items:center;justify-content:center;gap:0.6rem;flex-wrap:wrap"><span style="font-size:0.8rem;color:#94a3b8;margin-right:0.25rem">ปรับเวลาสดบนเวที:</span><button style="display:inline-flex;align-items:center;gap:0.25rem;padding:0.35rem 0.75rem;background:rgba(56, 189, 248, 0.15);border:1px solid rgba(56, 189, 248, 0.35);border-radius:8px;color:#7dd3fc;font-size:0.82rem;font-weight:600;cursor:pointer"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-plus lucide-plus-circle" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M8 12h8"></path><path d="M12 8v8"></path></svg> +30 วินาที</button><button style="display:inline-flex;align-items:center;gap:0.25rem;padding:0.35rem 0.75rem;background:rgba(34, 197, 94, 0.15);border:1px solid rgba(34, 197, 94, 0.35);border-radius:8px;color:#86efac;font-size:0.82rem;font-weight:600;cursor:pointer"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-plus lucide-plus-circle" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M8 12h8"></path><path d="M12 8v8"></path></svg> +10 วินาที</button><button style="display:inline-flex;align-items:center;gap:0.25rem;padding:0.35rem 0.75rem;background:rgba(239, 68, 68, 0.15);border:1px solid rgba(239, 68, 68, 0.35);border-radius:8px;color:#fca5a5;font-size:0.82rem;font-weight:600;cursor:pointer"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-minus lucide-minus-circle" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M8 12h8"></path></svg> -10 วินาที</button></div></div><div style="background:rgba(14, 18, 44, 0.65);padding:1.25rem;border-radius:14px;border:1px solid rgba(124, 58, 237, 0.25)"><div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:1rem"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-panels-top-left lucide-layout" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M3 9h18"></path><path d="M9 21V9"></path></svg><div><div style="color:#f8fafc;font-size:0.95rem;font-weight:600">รูปแบบการแสดงผลบนเวที (Stage Display Mode)</div><div style="color:#94a3b8;font-size:0.75rem">เลือกตำแหน่งและรูปแบบตัวนับเวลาบนจอเวทีหลัก (Sync อัตโนมัติแบบ Realtime)</div></div></div><div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(140px, 1fr));gap:0.6rem;margin-bottom:1rem"><button style="padding:0.75rem 0.6rem;background:rgba(124, 58, 237, 0.25);border:1.5px solid var(--ctl-accent);border-radius:10px;color:#c7d2fe;cursor:pointer;text-align:left"><div style="display:flex;align-items:center;gap:0.35rem;font-weight:700;font-size:0.88rem"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fde047" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles lucide-stars" aria-hidden="true"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"></path><path d="M20 2v4"></path><path d="M22 4h-4"></path><circle cx="4" cy="20" r="2"></circle></svg> จอใหญ่ตรงกลาง</div><div style="font-size:0.7rem;margin-top:0.2rem;color:#94a3b8">Grand Center Focus (แนะนำสำหรับเวทีประกวด)</div></button><button style="padding:0.75rem 0.6rem;background:rgba(255, 255, 255, 0.04);border:1.5px solid rgba(255, 255, 255, 0.1);border-radius:10px;color:#94a3b8;cursor:pointer;text-align:left"><div class="ui-ico-label" style="font-weight:700;font-size:0.88rem"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pin" aria-hidden="true"><path d="M12 17v5"></path><path d="M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z"></path></svg>มุมขวาบน</div><div style="font-size:0.7rem;margin-top:0.2rem;color:#94a3b8">Corner HUD คลาสสิก</div></button><button style="padding:0.75rem 0.6rem;background:rgba(255, 255, 255, 0.04);border:1.5px solid rgba(255, 255, 255, 0.1);border-radius:10px;color:#94a3b8;cursor:pointer;text-align:left"><div class="ui-ico-label" style="font-weight:700;font-size:0.88rem"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-panel-top" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M3 9h18"></path></svg>แถบกะทัดรัด</div><div style="font-size:0.7rem;margin-top:0.2rem;color:#94a3b8">Floating Capsule HUD</div></button></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;padding-top:0.75rem;border-top:1px solid rgba(255,255,255,0.08)"><div style="display:flex;align-items:center;justify-content:space-between;background:rgba(0,0,0,0.25);padding:0.65rem 0.85rem;border-radius:8px"><div><div style="font-size:0.82rem;color:#f8fafc;font-weight:600">ซ่อนจนกว่าจะกดเริ่ม</div><div style="font-size:0.7rem;color:#94a3b8">ไม่แสดงนาฬิกาล่วงหน้า</div></div><button style="padding:0.3rem 0.6rem;border-radius:6px;border:none;font-size:0.75rem;font-weight:700;cursor:pointer;background:#10b981;color:#000">เปิด (ON)</button></div><div style="display:flex;align-items:center;justify-content:space-between;background:rgba(0,0,0,0.25);padding:0.65rem 0.85rem;border-radius:8px"><div><div style="font-size:0.82rem;color:#f8fafc;font-weight:600">เริ่มนับเวลาออโต้</div><div style="font-size:0.7rem;color:#94a3b8">เมื่อเปิดคำถามสำเร็จ</div></div><button style="padding:0.3rem 0.6rem;border-radius:6px;border:none;font-size:0.75rem;font-weight:700;cursor:pointer;background:rgba(255,255,255,0.1);color:#94a3b8">ปิด (OFF)</button></div></div><div style="display:flex;align-items:center;justify-content:space-between;margin-top:0.75rem;padding-top:0.6rem;border-top:1px solid rgba(255,255,255,0.06)"><div style="display:flex;align-items:center;gap:0.35rem;font-size:0.82rem;color:#cbd5e1"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-type" aria-hidden="true"><path d="M12 4v16"></path><path d="M4 7V5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v2"></path><path d="M9 20h6"></path></svg><span>ขนาดตัวอักษรคำถามบนเวที:</span></div><div style="display:flex;gap:0.35rem"><button style="padding:0.25rem 0.6rem;border-radius:6px;font-size:0.75rem;font-weight:700;background:rgba(56, 189, 248, 0.25);border:1px solid #38bdf8;color:#7dd3fc;cursor:pointer">ปกติ</button><button style="padding:0.25rem 0.6rem;border-radius:6px;font-size:0.75rem;font-weight:500;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);color:#94a3b8;cursor:pointer">ใหญ่</button><button style="padding:0.25rem 0.6rem;border-radius:6px;font-size:0.75rem;font-weight:500;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);color:#94a3b8;cursor:pointer">ใหญ่พิเศษ</button></div></div></div><div style="background:rgba(14, 18, 44, 0.55);padding:1.25rem;border-radius:14px;border:1px solid rgba(255, 255, 255, 0.08)"><div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.9rem"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sliders-vertical lucide-sliders" aria-hidden="true"><path d="M10 8h4"></path><path d="M12 21v-9"></path><path d="M12 8V3"></path><path d="M17 16h4"></path><path d="M19 12V3"></path><path d="M19 21v-5"></path><path d="M3 14h4"></path><path d="M5 10V3"></path><path d="M5 21v-7"></path></svg><div><div style="color:#f8fafc;font-size:0.95rem;font-weight:600">เกณฑ์เวลาเตือนและช่วงวิกฤต (Alert Thresholds)</div><div style="color:#94a3b8;font-size:0.75rem">กำหนดวินาทีที่ระบบจะเปลี่ยนสีและส่งสัญญาณเตือน</div></div></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem"><div><div style="display:flex;justify-content:space-between;font-size:0.8rem;color:#fde68a;margin-bottom:0.35rem"><span>ช่วงเตือน (Warning):</span><strong>30<!-- --> วินาที</strong></div><input type="range" min="10" max="60" step="5" style="width:100%;accent-color:#f59e0b" value="30"/></div><div><div style="display:flex;justify-content:space-between;font-size:0.8rem;color:#fca5a5;margin-bottom:0.35rem"><span>ช่วงวิกฤต (Critical):</span><strong>10<!-- --> วินาที</strong></div><input type="range" min="3" max="20" step="1" style="width:100%;accent-color:#ef4444" value="10"/></div></div></div><div style="background:rgba(14, 18, 44, 0.65);padding:1.25rem;border-radius:14px;border:1px solid rgba(255, 255, 255, 0.09)"><div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:1rem"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-bell" aria-hidden="true"><path d="M10.268 21a2 2 0 0 0 3.464 0"></path><path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"></path></svg><div><div style="color:#f8fafc;font-size:0.95rem;font-weight:600">ระบบเสียงตัวจับเวลา (Timer Audio Controls)</div><div style="color:#94a3b8;font-size:0.75rem">ตั้งค่าเปิด/ปิดเสียงติ๊ก, เสียงเตือนใกล้หมด และเสียงเมื่อหมดเวลา (Sync สู่เวทีแบบ Realtime)</div></div></div><div style="display:flex;flex-direction:column;gap:0.65rem"><div style="display:flex;align-items:center;justify-content:space-between;background:rgba(0, 0, 0, 0.25);padding:0.65rem 0.85rem;border-radius:8px"><div><div style="font-size:0.84rem;color:#f8fafc;font-weight:600;display:flex;align-items:center;gap:0.35rem"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg> เสียงติ๊กนับถอยหลัง (Countdown Ticks)</div><div style="font-size:0.72rem;color:#94a3b8">เสียงติ๊กเบาๆ ทุกวินาทีตามจังหวะเวลาปกติ</div></div><button type="button" style="padding:0.35rem 0.75rem;border-radius:6px;border:none;font-size:0.75rem;font-weight:700;cursor:pointer;background:#10b981;color:#000;transition:all 0.2s">เปิด (ON)</button></div><div style="display:flex;align-items:center;justify-content:space-between;background:rgba(0, 0, 0, 0.25);padding:0.65rem 0.85rem;border-radius:8px"><div><div style="font-size:0.84rem;color:#f8fafc;font-weight:600;display:flex;align-items:center;gap:0.35rem"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-triangle-alert lucide-alert-triangle" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg> เสียงเตือนช่วงใกล้หมดเวลา (Warning / Critical)</div><div style="font-size:0.72rem;color:#94a3b8">เสียงเตือนพิเศษช่วงวิกฤต (≤10s) และ 3 วินาทีสุดท้าย</div></div><button type="button" style="padding:0.35rem 0.75rem;border-radius:6px;border:none;font-size:0.75rem;font-weight:700;cursor:pointer;background:#f59e0b;color:#000;transition:all 0.2s">เปิด (ON)</button></div><div style="display:flex;align-items:center;justify-content:space-between;background:rgba(0, 0, 0, 0.25);padding:0.65rem 0.85rem;border-radius:8px"><div><div style="font-size:0.84rem;color:#f8fafc;font-weight:600;display:flex;align-items:center;gap:0.35rem"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-flame" aria-hidden="true"><path d="M12 3q1 4 4 6.5t3 5.5a1 1 0 0 1-14 0 5 5 0 0 1 1-3 1 1 0 0 0 5 0c0-2-1.5-3-1.5-5q0-2 2.5-4"></path></svg> เสียงสัญญาณเมื่อหมดเวลา (Timeout Finish Gong)</div><div style="font-size:0.72rem;color:#94a3b8">เสียงระฆังแจ้งเตือนเมื่อนับถึง 00:00</div></div><button type="button" style="padding:0.35rem 0.75rem;border-radius:6px;border:none;font-size:0.75rem;font-weight:700;cursor:pointer;background:#ef4444;color:#fff;transition:all 0.2s">เปิด (ON)</button></div></div><div style="margin-top:0.9rem;padding-top:0.8rem;border-top:1px solid rgba(255, 255, 255, 0.08)"><div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.6rem"><span style="font-size:0.8rem;color:#94a3b8;min-width:95px">ระดับความดังเสียง:</span><input type="range" min="0" max="1" step="0.05" style="flex:1;accent-color:#38bdf8" value="0.6"/><span style="font-size:0.8rem;color:#cbd5e1;min-width:40px;text-align:right;font-weight:600">60<!-- -->%</span></div><div style="display:flex;align-items:center;gap:0.4rem;justify-content:flex-end;flex-wrap:wrap"><span style="font-size:0.75rem;color:#94a3b8;margin-right:auto">ทดสอบเสียงตัวอย่าง:</span><button type="button" style="padding:0.25rem 0.55rem;background:rgba(56, 189, 248, 0.12);border:1px solid rgba(56, 189, 248, 0.3);border-radius:6px;color:#7dd3fc;font-size:0.74rem;cursor:pointer">ติ๊กปกติ</button><button type="button" style="padding:0.25rem 0.55rem;background:rgba(245, 158, 11, 0.15);border:1px solid rgba(245, 158, 11, 0.35);border-radius:6px;color:#fde68a;font-size:0.74rem;cursor:pointer">เตือน 3 วินาที</button><button type="button" style="padding:0.25rem 0.55rem;background:rgba(239, 68, 68, 0.15);border:1px solid rgba(239, 68, 68, 0.35);border-radius:6px;color:#fca5a5;font-size:0.74rem;cursor:pointer">หมดเวลา</button></div></div></div><div style="background:rgba(14, 18, 44, 0.5);padding:1.25rem;border-radius:12px;border:1px solid rgba(255, 255, 255, 0.08)"><h4 style="margin:0 0 0.75rem 0;color:#f8fafc;font-size:0.9rem;display:flex;align-items:center;gap:0.4rem"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#eab308" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-zap" aria-hidden="true"><path d="M15.914 4a1.5 1.5 0 00-2.474-1.561l-9 9A1.5 1.5 0 005.5 14h4.002a.5.5 0 01.471.666L8.086 20a1.5 1.5 0 002.475 1.56l9-9A1.5 1.5 0 0018.5 10h-3.997a.5.5 0 01-.472-.667z"></path></svg> ค่าเวลามาตรฐาน (Presets)</h4><div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(130px, 1fr));gap:0.6rem"><button style="padding:0.75rem 0.6rem;background:rgba(255, 255, 255, 0.03);border:1px solid rgba(255, 255, 255, 0.08);border-radius:8px;color:#cbd5e1;cursor:pointer;text-align:center;transition:all 0.2s"><div style="font-size:1.1rem;font-weight:700">30s</div><div style="font-size:0.7rem;color:#94a3b8;margin-top:0.2rem">Quick / ซักถามด่วน</div></button><button style="padding:0.75rem 0.6rem;background:rgba(124, 58, 237, 0.2);border:1px solid var(--ctl-accent);border-radius:8px;color:var(--ctl-accent-pale);cursor:pointer;text-align:center;transition:all 0.2s"><div style="font-size:1.1rem;font-weight:700">1m</div><div style="font-size:0.7rem;color:#94a3b8;margin-top:0.2rem">Short / รอบทั่วไป</div></button><button style="padding:0.75rem 0.6rem;background:rgba(255, 255, 255, 0.03);border:1px solid rgba(255, 255, 255, 0.08);border-radius:8px;color:#cbd5e1;cursor:pointer;text-align:center;transition:all 0.2s"><div style="font-size:1.1rem;font-weight:700">1m 30s</div><div style="font-size:0.7rem;color:#94a3b8;margin-top:0.2rem">Standard / มาตรฐาน</div></button><button style="padding:0.75rem 0.6rem;background:rgba(255, 255, 255, 0.03);border:1px solid rgba(255, 255, 255, 0.08);border-radius:8px;color:#cbd5e1;cursor:pointer;text-align:center;transition:all 0.2s"><div style="font-size:1.1rem;font-weight:700">2m</div><div style="font-size:0.7rem;color:#94a3b8;margin-top:0.2rem">Final / รอบตัดสิน</div></button></div></div><form style="background:rgba(14, 18, 44, 0.5);padding:1.25rem;border-radius:12px;border:1px solid rgba(255, 255, 255, 0.08);display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap"><span style="color:#cbd5e1;font-size:0.85rem;display:flex;align-items:center;gap:0.35rem"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg> กำหนดเวลาเอง:</span><div style="display:flex;align-items:center;gap:0.35rem"><input type="number" min="0" max="59" style="width:55px;padding:0.4rem;background:rgba(0,0,0,0.5);border:1px solid rgba(255,255,255,0.15);border-radius:6px;color:#fff;text-align:center" value="1"/><span style="color:#94a3b8">นาที</span></div><div style="display:flex;align-items:center;gap:0.35rem"><input type="number" min="0" max="59" style="width:55px;padding:0.4rem;background:rgba(0,0,0,0.5);border:1px solid rgba(255,255,255,0.15);border-radius:6px;color:#fff;text-align:center" value="30"/><span style="color:#94a3b8">วินาที</span></div><button type="submit" style="padding:0.45rem 1rem;background:rgba(255, 255, 255, 0.1);border:1px solid rgba(255, 255, 255, 0.2);border-radius:6px;color:#fff;font-size:0.85rem;cursor:pointer">ตั้งค่าเวลานี้</button></form></div>"`;

exports[`split panels render the same markup > TimerPanel (finished) 1`] = `"<div class="ui-panel-stack"><div style="background:linear-gradient(135deg, rgba(239, 68, 68, 0.18), rgba(14, 18, 44, 0.75));border:1.5px solid rgba(239, 68, 68, 0.6);border-radius:16px;padding:1.5rem;text-align:center;box-shadow:0 8px 32px rgba(0, 0, 0, 0.35);transition:all 0.3s ease"><div style="display:flex;justify-content:center;align-items:center;gap:0.6rem;margin-bottom:0.5rem;flex-wrap:wrap"><span style="padding:0.25rem 0.75rem;border-radius:9999px;font-size:0.75rem;font-weight:700;text-transform:uppercase;background:rgba(239, 68, 68, 0.2);color:#fca5a5;border:1px solid rgba(255, 255, 255, 0.1)">finished</span></div><div style="font-family:&#x27;Outfit&#x27;, monospace, system-ui;font-size:4.2rem;font-weight:800;color:#fca5a5;letter-spacing:0.06em;margin:0.4rem 0;line-height:1">หมดเวลา</div><div style="height:6px;width:100%;max-width:340px;margin:0.75rem auto;background:rgba(255,255,255,0.1);border-radius:9999px;overflow:hidden"><div style="width:0%;height:100%;background:linear-gradient(90deg, #0284c7, #38bdf8);transition:width 0.18s linear"></div></div><div style="display:flex;justify-content:center;gap:0.6rem;margin-top:1.25rem;flex-wrap:wrap"><button style="display:inline-flex;align-items:center;gap:0.4rem;padding:0.75rem 1.6rem;background:linear-gradient(135deg, #22c55e, #16a34a);border:none;border-radius:10px;color:#fff;font-size:1rem;font-weight:700;cursor:pointer;box-shadow:0 4px 15px rgba(34, 197, 94, 0.35)"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-play" aria-hidden="true"><path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"></path></svg> <!-- -->เริ่มจับเวลา (Start) [T]</button><button style="display:inline-flex;align-items:center;gap:0.4rem;padding:0.75rem 1.15rem;background:rgba(255, 255, 255, 0.08);border:1px solid rgba(255, 255, 255, 0.15);border-radius:10px;color:#cbd5e1;font-size:0.9rem;cursor:pointer"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-ccw" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg> รีเซ็ต (Reset)</button><button disabled="" style="display:inline-flex;align-items:center;gap:0.4rem;padding:0.75rem 1.15rem;background:rgba(239, 68, 68, 0.15);border:1px solid rgba(239, 68, 68, 0.3);border-radius:10px;color:#fca5a5;font-size:0.9rem;cursor:not-allowed;opacity:0.5"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check lucide-check-circle-2" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m16 9-5.5 5.5L8 12"></path></svg> จบเวลา (Finish)</button></div><div style="margin-top:1.1rem;padding-top:1rem;border-top:1px solid rgba(255, 255, 255, 0.08);display:flex;align-items:center;justify-content:center;gap:0.6rem;flex-wrap:wrap"><span style="font-size:0.8rem;color:#94a3b8;margin-right:0.25rem">ปรับเวลาสดบนเวที:</span><button style="display:inline-flex;align-items:center;gap:0.25rem;padding:0.35rem 0.75rem;background:rgba(56, 189, 248, 0.15);border:1px solid rgba(56, 189, 248, 0.35);border-radius:8px;color:#7dd3fc;font-size:0.82rem;font-weight:600;cursor:pointer"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-plus lucide-plus-circle" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M8 12h8"></path><path d="M12 8v8"></path></svg> +30 วินาที</button><button style="display:inline-flex;align-items:center;gap:0.25rem;padding:0.35rem 0.75rem;background:rgba(34, 197, 94, 0.15);border:1px solid rgba(34, 197, 94, 0.35);border-radius:8px;color:#86efac;font-size:0.82rem;font-weight:600;cursor:pointer"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-plus lucide-plus-circle" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M8 12h8"></path><path d="M12 8v8"></path></svg> +10 วินาที</button><button style="display:inline-flex;align-items:center;gap:0.25rem;padding:0.35rem 0.75rem;background:rgba(239, 68, 68, 0.15);border:1px solid rgba(239, 68, 68, 0.35);border-radius:8px;color:#fca5a5;font-size:0.82rem;font-weight:600;cursor:pointer"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-minus lucide-minus-circle" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M8 12h8"></path></svg> -10 วินาที</button></div></div><div style="background:rgba(14, 18, 44, 0.65);padding:1.25rem;border-radius:14px;border:1px solid rgba(124, 58, 237, 0.25)"><div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:1rem"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-panels-top-left lucide-layout" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M3 9h18"></path><path d="M9 21V9"></path></svg><div><div style="color:#f8fafc;font-size:0.95rem;font-weight:600">รูปแบบการแสดงผลบนเวที (Stage Display Mode)</div><div style="color:#94a3b8;font-size:0.75rem">เลือกตำแหน่งและรูปแบบตัวนับเวลาบนจอเวทีหลัก (Sync อัตโนมัติแบบ Realtime)</div></div></div><div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(140px, 1fr));gap:0.6rem;margin-bottom:1rem"><button style="padding:0.75rem 0.6rem;background:rgba(124, 58, 237, 0.25);border:1.5px solid var(--ctl-accent);border-radius:10px;color:#c7d2fe;cursor:pointer;text-align:left"><div style="display:flex;align-items:center;gap:0.35rem;font-weight:700;font-size:0.88rem"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fde047" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles lucide-stars" aria-hidden="true"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"></path><path d="M20 2v4"></path><path d="M22 4h-4"></path><circle cx="4" cy="20" r="2"></circle></svg> จอใหญ่ตรงกลาง</div><div style="font-size:0.7rem;margin-top:0.2rem;color:#94a3b8">Grand Center Focus (แนะนำสำหรับเวทีประกวด)</div></button><button style="padding:0.75rem 0.6rem;background:rgba(255, 255, 255, 0.04);border:1.5px solid rgba(255, 255, 255, 0.1);border-radius:10px;color:#94a3b8;cursor:pointer;text-align:left"><div class="ui-ico-label" style="font-weight:700;font-size:0.88rem"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pin" aria-hidden="true"><path d="M12 17v5"></path><path d="M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z"></path></svg>มุมขวาบน</div><div style="font-size:0.7rem;margin-top:0.2rem;color:#94a3b8">Corner HUD คลาสสิก</div></button><button style="padding:0.75rem 0.6rem;background:rgba(255, 255, 255, 0.04);border:1.5px solid rgba(255, 255, 255, 0.1);border-radius:10px;color:#94a3b8;cursor:pointer;text-align:left"><div class="ui-ico-label" style="font-weight:700;font-size:0.88rem"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-panel-top" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M3 9h18"></path></svg>แถบกะทัดรัด</div><div style="font-size:0.7rem;margin-top:0.2rem;color:#94a3b8">Floating Capsule HUD</div></button></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;padding-top:0.75rem;border-top:1px solid rgba(255,255,255,0.08)"><div style="display:flex;align-items:center;justify-content:space-between;background:rgba(0,0,0,0.25);padding:0.65rem 0.85rem;border-radius:8px"><div><div style="font-size:0.82rem;color:#f8fafc;font-weight:600">ซ่อนจนกว่าจะกดเริ่ม</div><div style="font-size:0.7rem;color:#94a3b8">ไม่แสดงนาฬิกาล่วงหน้า</div></div><button style="padding:0.3rem 0.6rem;border-radius:6px;border:none;font-size:0.75rem;font-weight:700;cursor:pointer;background:#10b981;color:#000">เปิด (ON)</button></div><div style="display:flex;align-items:center;justify-content:space-between;background:rgba(0,0,0,0.25);padding:0.65rem 0.85rem;border-radius:8px"><div><div style="font-size:0.82rem;color:#f8fafc;font-weight:600">เริ่มนับเวลาออโต้</div><div style="font-size:0.7rem;color:#94a3b8">เมื่อเปิดคำถามสำเร็จ</div></div><button style="padding:0.3rem 0.6rem;border-radius:6px;border:none;font-size:0.75rem;font-weight:700;cursor:pointer;background:rgba(255,255,255,0.1);color:#94a3b8">ปิด (OFF)</button></div></div><div style="display:flex;align-items:center;justify-content:space-between;margin-top:0.75rem;padding-top:0.6rem;border-top:1px solid rgba(255,255,255,0.06)"><div style="display:flex;align-items:center;gap:0.35rem;font-size:0.82rem;color:#cbd5e1"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-type" aria-hidden="true"><path d="M12 4v16"></path><path d="M4 7V5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v2"></path><path d="M9 20h6"></path></svg><span>ขนาดตัวอักษรคำถามบนเวที:</span></div><div style="display:flex;gap:0.35rem"><button style="padding:0.25rem 0.6rem;border-radius:6px;font-size:0.75rem;font-weight:700;background:rgba(56, 189, 248, 0.25);border:1px solid #38bdf8;color:#7dd3fc;cursor:pointer">ปกติ</button><button style="padding:0.25rem 0.6rem;border-radius:6px;font-size:0.75rem;font-weight:500;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);color:#94a3b8;cursor:pointer">ใหญ่</button><button style="padding:0.25rem 0.6rem;border-radius:6px;font-size:0.75rem;font-weight:500;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);color:#94a3b8;cursor:pointer">ใหญ่พิเศษ</button></div></div></div><div style="background:rgba(14, 18, 44, 0.55);padding:1.25rem;border-radius:14px;border:1px solid rgba(255, 255, 255, 0.08)"><div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.9rem"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sliders-vertical lucide-sliders" aria-hidden="true"><path d="M10 8h4"></path><path d="M12 21v-9"></path><path d="M12 8V3"></path><path d="M17 16h4"></path><path d="M19 12V3"></path><path d="M19 21v-5"></path><path d="M3 14h4"></path><path d="M5 10V3"></path><path d="M5 21v-7"></path></svg><div><div style="color:#f8fafc;font-size:0.95rem;font-weight:600">เกณฑ์เวลาเตือนและช่วงวิกฤต (Alert Thresholds)</div><div style="color:#94a3b8;font-size:0.75rem">กำหนดวินาทีที่ระบบจะเปลี่ยนสีและส่งสัญญาณเตือน</div></div></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem"><div><div style="display:flex;justify-content:space-between;font-size:0.8rem;color:#fde68a;margin-bottom:0.35rem"><span>ช่วงเตือน (Warning):</span><strong>30<!-- --> วินาที</strong></div><input type="range" min="10" max="60" step="5" style="width:100%;accent-color:#f59e0b" value="30"/></div><div><div style="display:flex;justify-content:space-between;font-size:0.8rem;color:#fca5a5;margin-bottom:0.35rem"><span>ช่วงวิกฤต (Critical):</span><strong>10<!-- --> วินาที</strong></div><input type="range" min="3" max="20" step="1" style="width:100%;accent-color:#ef4444" value="10"/></div></div></div><div style="background:rgba(14, 18, 44, 0.65);padding:1.25rem;border-radius:14px;border:1px solid rgba(255, 255, 255, 0.09)"><div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:1rem"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-bell" aria-hidden="true"><path d="M10.268 21a2 2 0 0 0 3.464 0"></path><path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"></path></svg><div><div style="color:#f8fafc;font-size:0.95rem;font-weight:600">ระบบเสียงตัวจับเวลา (Timer Audio Controls)</div><div style="color:#94a3b8;font-size:0.75rem">ตั้งค่าเปิด/ปิดเสียงติ๊ก, เสียงเตือนใกล้หมด และเสียงเมื่อหมดเวลา (Sync สู่เวทีแบบ Realtime)</div></div></div><div style="display:flex;flex-direction:column;gap:0.65rem"><div style="display:flex;align-items:center;justify-content:space-between;background:rgba(0, 0, 0, 0.25);padding:0.65rem 0.85rem;border-radius:8px"><div><div style="font-size:0.84rem;color:#f8fafc;font-weight:600;display:flex;align-items:center;gap:0.35rem"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg> เสียงติ๊กนับถอยหลัง (Countdown Ticks)</div><div style="font-size:0.72rem;color:#94a3b8">เสียงติ๊กเบาๆ ทุกวินาทีตามจังหวะเวลาปกติ</div></div><button type="button" style="padding:0.35rem 0.75rem;border-radius:6px;border:none;font-size:0.75rem;font-weight:700;cursor:pointer;background:#10b981;color:#000;transition:all 0.2s">เปิด (ON)</button></div><div style="display:flex;align-items:center;justify-content:space-between;background:rgba(0, 0, 0, 0.25);padding:0.65rem 0.85rem;border-radius:8px"><div><div style="font-size:0.84rem;color:#f8fafc;font-weight:600;display:flex;align-items:center;gap:0.35rem"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-triangle-alert lucide-alert-triangle" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg> เสียงเตือนช่วงใกล้หมดเวลา (Warning / Critical)</div><div style="font-size:0.72rem;color:#94a3b8">เสียงเตือนพิเศษช่วงวิกฤต (≤10s) และ 3 วินาทีสุดท้าย</div></div><button type="button" style="padding:0.35rem 0.75rem;border-radius:6px;border:none;font-size:0.75rem;font-weight:700;cursor:pointer;background:#f59e0b;color:#000;transition:all 0.2s">เปิด (ON)</button></div><div style="display:flex;align-items:center;justify-content:space-between;background:rgba(0, 0, 0, 0.25);padding:0.65rem 0.85rem;border-radius:8px"><div><div style="font-size:0.84rem;color:#f8fafc;font-weight:600;display:flex;align-items:center;gap:0.35rem"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-flame" aria-hidden="true"><path d="M12 3q1 4 4 6.5t3 5.5a1 1 0 0 1-14 0 5 5 0 0 1 1-3 1 1 0 0 0 5 0c0-2-1.5-3-1.5-5q0-2 2.5-4"></path></svg> เสียงสัญญาณเมื่อหมดเวลา (Timeout Finish Gong)</div><div style="font-size:0.72rem;color:#94a3b8">เสียงระฆังแจ้งเตือนเมื่อนับถึง 00:00</div></div><button type="button" style="padding:0.35rem 0.75rem;border-radius:6px;border:none;font-size:0.75rem;font-weight:700;cursor:pointer;background:#ef4444;color:#fff;transition:all 0.2s">เปิด (ON)</button></div></div><div style="margin-top:0.9rem;padding-top:0.8rem;border-top:1px solid rgba(255, 255, 255, 0.08)"><div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.6rem"><span style="font-size:0.8rem;color:#94a3b8;min-width:95px">ระดับความดังเสียง:</span><input type="range" min="0" max="1" step="0.05" style="flex:1;accent-color:#38bdf8" value="0.6"/><span style="font-size:0.8rem;color:#cbd5e1;min-width:40px;text-align:right;font-weight:600">60<!-- -->%</span></div><div style="display:flex;align-items:center;gap:0.4rem;justify-content:flex-end;flex-wrap:wrap"><span style="font-size:0.75rem;color:#94a3b8;margin-right:auto">ทดสอบเสียงตัวอย่าง:</span><button type="button" style="padding:0.25rem 0.55rem;background:rgba(56, 189, 248, 0.12);border:1px solid rgba(56, 189, 248, 0.3);border-radius:6px;color:#7dd3fc;font-size:0.74rem;cursor:pointer">ติ๊กปกติ</button><button type="button" style="padding:0.25rem 0.55rem;background:rgba(245, 158, 11, 0.15);border:1px solid rgba(245, 158, 11, 0.35);border-radius:6px;color:#fde68a;font-size:0.74rem;cursor:pointer">เตือน 3 วินาที</button><button type="button" style="padding:0.25rem 0.55rem;background:rgba(239, 68, 68, 0.15);border:1px solid rgba(239, 68, 68, 0.35);border-radius:6px;color:#fca5a5;font-size:0.74rem;cursor:pointer">หมดเวลา</button></div></div></div><div style="background:rgba(14, 18, 44, 0.5);padding:1.25rem;border-radius:12px;border:1px solid rgba(255, 255, 255, 0.08)"><h4 style="margin:0 0 0.75rem 0;color:#f8fafc;font-size:0.9rem;display:flex;align-items:center;gap:0.4rem"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#eab308" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-zap" aria-hidden="true"><path d="M15.914 4a1.5 1.5 0 00-2.474-1.561l-9 9A1.5 1.5 0 005.5 14h4.002a.5.5 0 01.471.666L8.086 20a1.5 1.5 0 002.475 1.56l9-9A1.5 1.5 0 0018.5 10h-3.997a.5.5 0 01-.472-.667z"></path></svg> ค่าเวลามาตรฐาน (Presets)</h4><div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(130px, 1fr));gap:0.6rem"><button style="padding:0.75rem 0.6rem;background:rgba(255, 255, 255, 0.03);border:1px solid rgba(255, 255, 255, 0.08);border-radius:8px;color:#cbd5e1;cursor:pointer;text-align:center;transition:all 0.2s"><div style="font-size:1.1rem;font-weight:700">30s</div><div style="font-size:0.7rem;color:#94a3b8;margin-top:0.2rem">Quick / ซักถามด่วน</div></button><button style="padding:0.75rem 0.6rem;background:rgba(124, 58, 237, 0.2);border:1px solid var(--ctl-accent);border-radius:8px;color:var(--ctl-accent-pale);cursor:pointer;text-align:center;transition:all 0.2s"><div style="font-size:1.1rem;font-weight:700">1m</div><div style="font-size:0.7rem;color:#94a3b8;margin-top:0.2rem">Short / รอบทั่วไป</div></button><button style="padding:0.75rem 0.6rem;background:rgba(255, 255, 255, 0.03);border:1px solid rgba(255, 255, 255, 0.08);border-radius:8px;color:#cbd5e1;cursor:pointer;text-align:center;transition:all 0.2s"><div style="font-size:1.1rem;font-weight:700">1m 30s</div><div style="font-size:0.7rem;color:#94a3b8;margin-top:0.2rem">Standard / มาตรฐาน</div></button><button style="padding:0.75rem 0.6rem;background:rgba(255, 255, 255, 0.03);border:1px solid rgba(255, 255, 255, 0.08);border-radius:8px;color:#cbd5e1;cursor:pointer;text-align:center;transition:all 0.2s"><div style="font-size:1.1rem;font-weight:700">2m</div><div style="font-size:0.7rem;color:#94a3b8;margin-top:0.2rem">Final / รอบตัดสิน</div></button></div></div><form style="background:rgba(14, 18, 44, 0.5);padding:1.25rem;border-radius:12px;border:1px solid rgba(255, 255, 255, 0.08);display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap"><span style="color:#cbd5e1;font-size:0.85rem;display:flex;align-items:center;gap:0.35rem"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg> กำหนดเวลาเอง:</span><div style="display:flex;align-items:center;gap:0.35rem"><input type="number" min="0" max="59" style="width:55px;padding:0.4rem;background:rgba(0,0,0,0.5);border:1px solid rgba(255,255,255,0.15);border-radius:6px;color:#fff;text-align:center" value="1"/><span style="color:#94a3b8">นาที</span></div><div style="display:flex;align-items:center;gap:0.35rem"><input type="number" min="0" max="59" style="width:55px;padding:0.4rem;background:rgba(0,0,0,0.5);border:1px solid rgba(255,255,255,0.15);border-radius:6px;color:#fff;text-align:center" value="30"/><span style="color:#94a3b8">วินาที</span></div><button type="submit" style="padding:0.45rem 1rem;background:rgba(255, 255, 255, 0.1);border:1px solid rgba(255, 255, 255, 0.2);border-radius:6px;color:#fff;font-size:0.85rem;cursor:pointer">ตั้งค่าเวลานี้</button></form></div>"`;

exports[`split panels render the same markup > TimerPanel (idle) 1`] = `"<div class="ui-panel-stack"><div style="background:linear-gradient(135deg, rgba(56, 189, 248, 0.12), rgba(14, 18, 44, 0.75));border:1.5px solid rgba(255, 255, 255, 0.15);border-radius:16px;padding:1.5rem;text-align:center;box-shadow:0 8px 32px rgba(0, 0, 0, 0.35);transition:all 0.3s ease"><div style="display:flex;justify-content:center;align-items:center;gap:0.6rem;margin-bottom:0.5rem;flex-wrap:wrap"><span style="padding:0.25rem 0.75rem;border-radius:9999px;font-size:0.75rem;font-weight:700;text-transform:uppercase;background:rgba(255, 255, 255, 0.1);color:#94a3b8;border:1px solid rgba(255, 255, 255, 0.1)">idle</span></div><div style="font-family:&#x27;Outfit&#x27;, monospace, system-ui;font-size:4.2rem;font-weight:800;color:#f8fafc;letter-spacing:0.06em;margin:0.4rem 0;line-height:1">01:30</div><div style="height:6px;width:100%;max-width:340px;margin:0.75rem auto;background:rgba(255,255,255,0.1);border-radius:9999px;overflow:hidden"><div style="width:100%;height:100%;background:linear-gradient(90deg, #0284c7, #38bdf8);transition:width 0.18s linear"></div></div><div style="display:flex;justify-content:center;gap:0.6rem;margin-top:1.25rem;flex-wrap:wrap"><button style="display:inline-flex;align-items:center;gap:0.4rem;padding:0.75rem 1.6rem;background:linear-gradient(135deg, #22c55e, #16a34a);border:none;border-radius:10px;color:#fff;font-size:1rem;font-weight:700;cursor:pointer;box-shadow:0 4px 15px rgba(34, 197, 94, 0.35)"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-play" aria-hidden="true"><path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"></path></svg> <!-- -->เริ่มจับเวลา (Start) [T]</button><button style="display:inline-flex;align-items:center;gap:0.4rem;padding:0.75rem 1.15rem;background:rgba(255, 255, 255, 0.08);border:1px solid rgba(255, 255, 255, 0.15);border-radius:10px;color:#cbd5e1;font-size:0.9rem;cursor:pointer"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-ccw" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg> รีเซ็ต (Reset)</button><button style="display:inline-flex;align-items:center;gap:0.4rem;padding:0.75rem 1.15rem;background:rgba(239, 68, 68, 0.15);border:1px solid rgba(239, 68, 68, 0.3);border-radius:10px;color:#fca5a5;font-size:0.9rem;cursor:pointer;opacity:1"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check lucide-check-circle-2" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m16 9-5.5 5.5L8 12"></path></svg> จบเวลา (Finish)</button></div><div style="margin-top:1.1rem;padding-top:1rem;border-top:1px solid rgba(255, 255, 255, 0.08);display:flex;align-items:center;justify-content:center;gap:0.6rem;flex-wrap:wrap"><span style="font-size:0.8rem;color:#94a3b8;margin-right:0.25rem">ปรับเวลาสดบนเวที:</span><button style="display:inline-flex;align-items:center;gap:0.25rem;padding:0.35rem 0.75rem;background:rgba(56, 189, 248, 0.15);border:1px solid rgba(56, 189, 248, 0.35);border-radius:8px;color:#7dd3fc;font-size:0.82rem;font-weight:600;cursor:pointer"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-plus lucide-plus-circle" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M8 12h8"></path><path d="M12 8v8"></path></svg> +30 วินาที</button><button style="display:inline-flex;align-items:center;gap:0.25rem;padding:0.35rem 0.75rem;background:rgba(34, 197, 94, 0.15);border:1px solid rgba(34, 197, 94, 0.35);border-radius:8px;color:#86efac;font-size:0.82rem;font-weight:600;cursor:pointer"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-plus lucide-plus-circle" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M8 12h8"></path><path d="M12 8v8"></path></svg> +10 วินาที</button><button style="display:inline-flex;align-items:center;gap:0.25rem;padding:0.35rem 0.75rem;background:rgba(239, 68, 68, 0.15);border:1px solid rgba(239, 68, 68, 0.35);border-radius:8px;color:#fca5a5;font-size:0.82rem;font-weight:600;cursor:pointer"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-minus lucide-minus-circle" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M8 12h8"></path></svg> -10 วินาที</button></div></div><div style="background:rgba(14, 18, 44, 0.65);padding:1.25rem;border-radius:14px;border:1px solid rgba(124, 58, 237, 0.25)"><div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:1rem"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-panels-top-left lucide-layout" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M3 9h18"></path><path d="M9 21V9"></path></svg><div><div style="color:#f8fafc;font-size:0.95rem;font-weight:600">รูปแบบการแสดงผลบนเวที (Stage Display Mode)</div><div style="color:#94a3b8;font-size:0.75rem">เลือกตำแหน่งและรูปแบบตัวนับเวลาบนจอเวทีหลัก (Sync อัตโนมัติแบบ Realtime)</div></div></div><div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(140px, 1fr));gap:0.6rem;margin-bottom:1rem"><button style="padding:0.75rem 0.6rem;background:rgba(124, 58, 237, 0.25);border:1.5px solid var(--ctl-accent);border-radius:10px;color:#c7d2fe;cursor:pointer;text-align:left"><div style="display:flex;align-items:center;gap:0.35rem;font-weight:700;font-size:0.88rem"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fde047" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles lucide-stars" aria-hidden="true"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"></path><path d="M20 2v4"></path><path d="M22 4h-4"></path><circle cx="4" cy="20" r="2"></circle></svg> จอใหญ่ตรงกลาง</div><div style="font-size:0.7rem;margin-top:0.2rem;color:#94a3b8">Grand Center Focus (แนะนำสำหรับเวทีประกวด)</div></button><button style="padding:0.75rem 0.6rem;background:rgba(255, 255, 255, 0.04);border:1.5px solid rgba(255, 255, 255, 0.1);border-radius:10px;color:#94a3b8;cursor:pointer;text-align:left"><div class="ui-ico-label" style="font-weight:700;font-size:0.88rem"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pin" aria-hidden="true"><path d="M12 17v5"></path><path d="M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z"></path></svg>มุมขวาบน</div><div style="font-size:0.7rem;margin-top:0.2rem;color:#94a3b8">Corner HUD คลาสสิก</div></button><button style="padding:0.75rem 0.6rem;background:rgba(255, 255, 255, 0.04);border:1.5px solid rgba(255, 255, 255, 0.1);border-radius:10px;color:#94a3b8;cursor:pointer;text-align:left"><div class="ui-ico-label" style="font-weight:700;font-size:0.88rem"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-panel-top" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M3 9h18"></path></svg>แถบกะทัดรัด</div><div style="font-size:0.7rem;margin-top:0.2rem;color:#94a3b8">Floating Capsule HUD</div></button></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;padding-top:0.75rem;border-top:1px solid rgba(255,255,255,0.08)"><div style="display:flex;align-items:center;justify-content:space-between;background:rgba(0,0,0,0.25);padding:0.65rem 0.85rem;border-radius:8px"><div><div style="font-size:0.82rem;color:#f8fafc;font-weight:600">ซ่อนจนกว่าจะกดเริ่ม</div><div style="font-size:0.7rem;color:#94a3b8">ไม่แสดงนาฬิกาล่วงหน้า</div></div><button style="padding:0.3rem 0.6rem;border-radius:6px;border:none;font-size:0.75rem;font-weight:700;cursor:pointer;background:#10b981;color:#000">เปิด (ON)</button></div><div style="display:flex;align-items:center;justify-content:space-between;background:rgba(0,0,0,0.25);padding:0.65rem 0.85rem;border-radius:8px"><div><div style="font-size:0.82rem;color:#f8fafc;font-weight:600">เริ่มนับเวลาออโต้</div><div style="font-size:0.7rem;color:#94a3b8">เมื่อเปิดคำถามสำเร็จ</div></div><button style="padding:0.3rem 0.6rem;border-radius:6px;border:none;font-size:0.75rem;font-weight:700;cursor:pointer;background:rgba(255,255,255,0.1);color:#94a3b8">ปิด (OFF)</button></div></div><div style="display:flex;align-items:center;justify-content:space-between;margin-top:0.75rem;padding-top:0.6rem;border-top:1px solid rgba(255,255,255,0.06)"><div style="display:flex;align-items:center;gap:0.35rem;font-size:0.82rem;color:#cbd5e1"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-type" aria-hidden="true"><path d="M12 4v16"></path><path d="M4 7V5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v2"></path><path d="M9 20h6"></path></svg><span>ขนาดตัวอักษรคำถามบนเวที:</span></div><div style="display:flex;gap:0.35rem"><button style="padding:0.25rem 0.6rem;border-radius:6px;font-size:0.75rem;font-weight:700;background:rgba(56, 189, 248, 0.25);border:1px solid #38bdf8;color:#7dd3fc;cursor:pointer">ปกติ</button><button style="padding:0.25rem 0.6rem;border-radius:6px;font-size:0.75rem;font-weight:500;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);color:#94a3b8;cursor:pointer">ใหญ่</button><button style="padding:0.25rem 0.6rem;border-radius:6px;font-size:0.75rem;font-weight:500;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);color:#94a3b8;cursor:pointer">ใหญ่พิเศษ</button></div></div></div><div style="background:rgba(14, 18, 44, 0.55);padding:1.25rem;border-radius:14px;border:1px solid rgba(255, 255, 255, 0.08)"><div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.9rem"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sliders-vertical lucide-sliders" aria-hidden="true"><path d="M10 8h4"></path><path d="M12 21v-9"></path><path d="M12 8V3"></path><path d="M17 16h4"></path><path d="M19 12V3"></path><path d="M19 21v-5"></path><path d="M3 14h4"></path><path d="M5 10V3"></path><path d="M5 21v-7"></path></svg><div><div style="color:#f8fafc;font-size:0.95rem;font-weight:600">เกณฑ์เวลาเตือนและช่วงวิกฤต (Alert Thresholds)</div><div style="color:#94a3b8;font-size:0.75rem">กำหนดวินาทีที่ระบบจะเปลี่ยนสีและส่งสัญญาณเตือน</div></div></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem"><div><div style="display:flex;justify-content:space-between;font-size:0.8rem;color:#fde68a;margin-bottom:0.35rem"><span>ช่วงเตือน (Warning):</span><strong>30<!-- --> วินาที</strong></div><input type="range" min="10" max="60" step="5" style="width:100%;accent-color:#f59e0b" value="30"/></div><div><div style="display:flex;justify-content:space-between;font-size:0.8rem;color:#fca5a5;margin-bottom:0.35rem"><span>ช่วงวิกฤต (Critical):</span><strong>10<!-- --> วินาที</strong></div><input type="range" min="3" max="20" step="1" style="width:100%;accent-color:#ef4444" value="10"/></div></div></div><div style="background:rgba(14, 18, 44, 0.65);padding:1.25rem;border-radius:14px;border:1px solid rgba(255, 255, 255, 0.09)"><div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:1rem"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-bell" aria-hidden="true"><path d="M10.268 21a2 2 0 0 0 3.464 0"></path><path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"></path></svg><div><div style="color:#f8fafc;font-size:0.95rem;font-weight:600">ระบบเสียงตัวจับเวลา (Timer Audio Controls)</div><div style="color:#94a3b8;font-size:0.75rem">ตั้งค่าเปิด/ปิดเสียงติ๊ก, เสียงเตือนใกล้หมด และเสียงเมื่อหมดเวลา (Sync สู่เวทีแบบ Realtime)</div></div></div><div style="display:flex;flex-direction:column;gap:0.65rem"><div style="display:flex;align-items:center;justify-content:space-between;background:rgba(0, 0, 0, 0.25);padding:0.65rem 0.85rem;border-radius:8px"><div><div style="font-size:0.84rem;color:#f8fafc;font-weight:600;display:flex;align-items:center;gap:0.35rem"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg> เสียงติ๊กนับถอยหลัง (Countdown Ticks)</div><div style="font-size:0.72rem;color:#94a3b8">เสียงติ๊กเบาๆ ทุกวินาทีตามจังหวะเวลาปกติ</div></div><button type="button" style="padding:0.35rem 0.75rem;border-radius:6px;border:none;font-size:0.75rem;font-weight:700;cursor:pointer;background:#10b981;color:#000;transition:all 0.2s">เปิด (ON)</button></div><div style="display:flex;align-items:center;justify-content:space-between;background:rgba(0, 0, 0, 0.25);padding:0.65rem 0.85rem;border-radius:8px"><div><div style="font-size:0.84rem;color:#f8fafc;font-weight:600;display:flex;align-items:center;gap:0.35rem"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-triangle-alert lucide-alert-triangle" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg> เสียงเตือนช่วงใกล้หมดเวลา (Warning / Critical)</div><div style="font-size:0.72rem;color:#94a3b8">เสียงเตือนพิเศษช่วงวิกฤต (≤10s) และ 3 วินาทีสุดท้าย</div></div><button type="button" style="padding:0.35rem 0.75rem;border-radius:6px;border:none;font-size:0.75rem;font-weight:700;cursor:pointer;background:#f59e0b;color:#000;transition:all 0.2s">เปิด (ON)</button></div><div style="display:flex;align-items:center;justify-content:space-between;background:rgba(0, 0, 0, 0.25);padding:0.65rem 0.85rem;border-radius:8px"><div><div style="font-size:0.84rem;color:#f8fafc;font-weight:600;display:flex;align-items:center;gap:0.35rem"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-flame" aria-hidden="true"><path d="M12 3q1 4 4 6.5t3 5.5a1 1 0 0 1-14 0 5 5 0 0 1 1-3 1 1 0 0 0 5 0c0-2-1.5-3-1.5-5q0-2 2.5-4"></path></svg> เสียงสัญญาณเมื่อหมดเวลา (Timeout Finish Gong)</div><div style="font-size:0.72rem;color:#94a3b8">เสียงระฆังแจ้งเตือนเมื่อนับถึง 00:00</div></div><button type="button" style="padding:0.35rem 0.75rem;border-radius:6px;border:none;font-size:0.75rem;font-weight:700;cursor:pointer;background:#ef4444;color:#fff;transition:all 0.2s">เปิด (ON)</button></div></div><div style="margin-top:0.9rem;padding-top:0.8rem;border-top:1px solid rgba(255, 255, 255, 0.08)"><div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.6rem"><span style="font-size:0.8rem;color:#94a3b8;min-width:95px">ระดับความดังเสียง:</span><input type="range" min="0" max="1" step="0.05" style="flex:1;accent-color:#38bdf8" value="0.6"/><span style="font-size:0.8rem;color:#cbd5e1;min-width:40px;text-align:right;font-weight:600">60<!-- -->%</span></div><div style="display:flex;align-items:center;gap:0.4rem;justify-content:flex-end;flex-wrap:wrap"><span style="font-size:0.75rem;color:#94a3b8;margin-right:auto">ทดสอบเสียงตัวอย่าง:</span><button type="button" style="padding:0.25rem 0.55rem;background:rgba(56, 189, 248, 0.12);border:1px solid rgba(56, 189, 248, 0.3);border-radius:6px;color:#7dd3fc;font-size:0.74rem;cursor:pointer">ติ๊กปกติ</button><button type="button" style="padding:0.25rem 0.55rem;background:rgba(245, 158, 11, 0.15);border:1px solid rgba(245, 158, 11, 0.35);border-radius:6px;color:#fde68a;font-size:0.74rem;cursor:pointer">เตือน 3 วินาที</button><button type="button" style="padding:0.25rem 0.55rem;background:rgba(239, 68, 68, 0.15);border:1px solid rgba(239, 68, 68, 0.35);border-radius:6px;color:#fca5a5;font-size:0.74rem;cursor:pointer">หมดเวลา</button></div></div></div><div style="background:rgba(14, 18, 44, 0.5);padding:1.25rem;border-radius:12px;border:1px solid rgba(255, 255, 255, 0.08)"><h4 style="margin:0 0 0.75rem 0;color:#f8fafc;font-size:0.9rem;display:flex;align-items:center;gap:0.4rem"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#eab308" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-zap" aria-hidden="true"><path d="M15.914 4a1.5 1.5 0 00-2.474-1.561l-9 9A1.5 1.5 0 005.5 14h4.002a.5.5 0 01.471.666L8.086 20a1.5 1.5 0 002.475 1.56l9-9A1.5 1.5 0 0018.5 10h-3.997a.5.5 0 01-.472-.667z"></path></svg> ค่าเวลามาตรฐาน (Presets)</h4><div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(130px, 1fr));gap:0.6rem"><button style="padding:0.75rem 0.6rem;background:rgba(255, 255, 255, 0.03);border:1px solid rgba(255, 255, 255, 0.08);border-radius:8px;color:#cbd5e1;cursor:pointer;text-align:center;transition:all 0.2s"><div style="font-size:1.1rem;font-weight:700">30s</div><div style="font-size:0.7rem;color:#94a3b8;margin-top:0.2rem">Quick / ซักถามด่วน</div></button><button style="padding:0.75rem 0.6rem;background:rgba(255, 255, 255, 0.03);border:1px solid rgba(255, 255, 255, 0.08);border-radius:8px;color:#cbd5e1;cursor:pointer;text-align:center;transition:all 0.2s"><div style="font-size:1.1rem;font-weight:700">1m</div><div style="font-size:0.7rem;color:#94a3b8;margin-top:0.2rem">Short / รอบทั่วไป</div></button><button style="padding:0.75rem 0.6rem;background:rgba(124, 58, 237, 0.2);border:1px solid var(--ctl-accent);border-radius:8px;color:var(--ctl-accent-pale);cursor:pointer;text-align:center;transition:all 0.2s"><div style="font-size:1.1rem;font-weight:700">1m 30s</div><div style="font-size:0.7rem;color:#94a3b8;margin-top:0.2rem">Standard / มาตรฐาน</div></button><button style="padding:0.75rem 0.6rem;background:rgba(255, 255, 255, 0.03);border:1px solid rgba(255, 255, 255, 0.08);border-radius:8px;color:#cbd5e1;cursor:pointer;text-align:center;transition:all 0.2s"><div style="font-size:1.1rem;font-weight:700">2m</div><div style="font-size:0.7rem;color:#94a3b8;margin-top:0.2rem">Final / รอบตัดสิน</div></button></div></div><form style="background:rgba(14, 18, 44, 0.5);padding:1.25rem;border-radius:12px;border:1px solid rgba(255, 255, 255, 0.08);display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap"><span style="color:#cbd5e1;font-size:0.85rem;display:flex;align-items:center;gap:0.35rem"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg> กำหนดเวลาเอง:</span><div style="display:flex;align-items:center;gap:0.35rem"><input type="number" min="0" max="59" style="width:55px;padding:0.4rem;background:rgba(0,0,0,0.5);border:1px solid rgba(255,255,255,0.15);border-radius:6px;color:#fff;text-align:center" value="1"/><span style="color:#94a3b8">นาที</span></div><div style="display:flex;align-items:center;gap:0.35rem"><input type="number" min="0" max="59" style="width:55px;padding:0.4rem;background:rgba(0,0,0,0.5);border:1px solid rgba(255,255,255,0.15);border-radius:6px;color:#fff;text-align:center" value="30"/><span style="color:#94a3b8">วินาที</span></div><button type="submit" style="padding:0.45rem 1rem;background:rgba(255, 255, 255, 0.1);border:1px solid rgba(255, 255, 255, 0.2);border-radius:6px;color:#fff;font-size:0.85rem;cursor:pointer">ตั้งค่าเวลานี้</button></form></div>"`;

exports[`split panels render the same markup > TimerPanel (paused) 1`] = `"<div class="ui-panel-stack"><div style="background:linear-gradient(135deg, rgba(56, 189, 248, 0.12), rgba(14, 18, 44, 0.75));border:1.5px solid rgba(255, 255, 255, 0.15);border-radius:16px;padding:1.5rem;text-align:center;box-shadow:0 8px 32px rgba(0, 0, 0, 0.35);transition:all 0.3s ease"><div style="display:flex;justify-content:center;align-items:center;gap:0.6rem;margin-bottom:0.5rem;flex-wrap:wrap"><span style="padding:0.25rem 0.75rem;border-radius:9999px;font-size:0.75rem;font-weight:700;text-transform:uppercase;background:rgba(234, 179, 8, 0.2);color:#fde047;border:1px solid rgba(255, 255, 255, 0.1)">paused</span></div><div style="font-family:&#x27;Outfit&#x27;, monospace, system-ui;font-size:4.2rem;font-weight:800;color:#f8fafc;letter-spacing:0.06em;margin:0.4rem 0;line-height:1">00:25</div><div style="height:6px;width:100%;max-width:340px;margin:0.75rem auto;background:rgba(255,255,255,0.1);border-radius:9999px;overflow:hidden"><div style="width:41.66666666666667%;height:100%;background:linear-gradient(90deg, #0284c7, #38bdf8);transition:width 0.18s linear"></div></div><div style="display:flex;justify-content:center;gap:0.6rem;margin-top:1.25rem;flex-wrap:wrap"><button style="display:inline-flex;align-items:center;gap:0.4rem;padding:0.75rem 1.6rem;background:linear-gradient(135deg, #22c55e, #16a34a);border:none;border-radius:10px;color:#fff;font-size:1rem;font-weight:700;cursor:pointer;box-shadow:0 4px 15px rgba(34, 197, 94, 0.35)"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-play" aria-hidden="true"><path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"></path></svg> <!-- -->นับต่อ (Resume)</button><button style="display:inline-flex;align-items:center;gap:0.4rem;padding:0.75rem 1.15rem;background:rgba(255, 255, 255, 0.08);border:1px solid rgba(255, 255, 255, 0.15);border-radius:10px;color:#cbd5e1;font-size:0.9rem;cursor:pointer"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-ccw" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg> รีเซ็ต (Reset)</button><button style="display:inline-flex;align-items:center;gap:0.4rem;padding:0.75rem 1.15rem;background:rgba(239, 68, 68, 0.15);border:1px solid rgba(239, 68, 68, 0.3);border-radius:10px;color:#fca5a5;font-size:0.9rem;cursor:pointer;opacity:1"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check lucide-check-circle-2" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m16 9-5.5 5.5L8 12"></path></svg> จบเวลา (Finish)</button></div><div style="margin-top:1.1rem;padding-top:1rem;border-top:1px solid rgba(255, 255, 255, 0.08);display:flex;align-items:center;justify-content:center;gap:0.6rem;flex-wrap:wrap"><span style="font-size:0.8rem;color:#94a3b8;margin-right:0.25rem">ปรับเวลาสดบนเวที:</span><button style="display:inline-flex;align-items:center;gap:0.25rem;padding:0.35rem 0.75rem;background:rgba(56, 189, 248, 0.15);border:1px solid rgba(56, 189, 248, 0.35);border-radius:8px;color:#7dd3fc;font-size:0.82rem;font-weight:600;cursor:pointer"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-plus lucide-plus-circle" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M8 12h8"></path><path d="M12 8v8"></path></svg> +30 วินาที</button><button style="display:inline-flex;align-items:center;gap:0.25rem;padding:0.35rem 0.75rem;background:rgba(34, 197, 94, 0.15);border:1px solid rgba(34, 197, 94, 0.35);border-radius:8px;color:#86efac;font-size:0.82rem;font-weight:600;cursor:pointer"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-plus lucide-plus-circle" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M8 12h8"></path><path d="M12 8v8"></path></svg> +10 วินาที</button><button style="display:inline-flex;align-items:center;gap:0.25rem;padding:0.35rem 0.75rem;background:rgba(239, 68, 68, 0.15);border:1px solid rgba(239, 68, 68, 0.35);border-radius:8px;color:#fca5a5;font-size:0.82rem;font-weight:600;cursor:pointer"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-minus lucide-minus-circle" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M8 12h8"></path></svg> -10 วินาที</button></div></div><div style="background:rgba(14, 18, 44, 0.65);padding:1.25rem;border-radius:14px;border:1px solid rgba(124, 58, 237, 0.25)"><div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:1rem"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-panels-top-left lucide-layout" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M3 9h18"></path><path d="M9 21V9"></path></svg><div><div style="color:#f8fafc;font-size:0.95rem;font-weight:600">รูปแบบการแสดงผลบนเวที (Stage Display Mode)</div><div style="color:#94a3b8;font-size:0.75rem">เลือกตำแหน่งและรูปแบบตัวนับเวลาบนจอเวทีหลัก (Sync อัตโนมัติแบบ Realtime)</div></div></div><div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(140px, 1fr));gap:0.6rem;margin-bottom:1rem"><button style="padding:0.75rem 0.6rem;background:rgba(124, 58, 237, 0.25);border:1.5px solid var(--ctl-accent);border-radius:10px;color:#c7d2fe;cursor:pointer;text-align:left"><div style="display:flex;align-items:center;gap:0.35rem;font-weight:700;font-size:0.88rem"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fde047" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles lucide-stars" aria-hidden="true"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"></path><path d="M20 2v4"></path><path d="M22 4h-4"></path><circle cx="4" cy="20" r="2"></circle></svg> จอใหญ่ตรงกลาง</div><div style="font-size:0.7rem;margin-top:0.2rem;color:#94a3b8">Grand Center Focus (แนะนำสำหรับเวทีประกวด)</div></button><button style="padding:0.75rem 0.6rem;background:rgba(255, 255, 255, 0.04);border:1.5px solid rgba(255, 255, 255, 0.1);border-radius:10px;color:#94a3b8;cursor:pointer;text-align:left"><div class="ui-ico-label" style="font-weight:700;font-size:0.88rem"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pin" aria-hidden="true"><path d="M12 17v5"></path><path d="M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z"></path></svg>มุมขวาบน</div><div style="font-size:0.7rem;margin-top:0.2rem;color:#94a3b8">Corner HUD คลาสสิก</div></button><button style="padding:0.75rem 0.6rem;background:rgba(255, 255, 255, 0.04);border:1.5px solid rgba(255, 255, 255, 0.1);border-radius:10px;color:#94a3b8;cursor:pointer;text-align:left"><div class="ui-ico-label" style="font-weight:700;font-size:0.88rem"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-panel-top" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M3 9h18"></path></svg>แถบกะทัดรัด</div><div style="font-size:0.7rem;margin-top:0.2rem;color:#94a3b8">Floating Capsule HUD</div></button></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;padding-top:0.75rem;border-top:1px solid rgba(255,255,255,0.08)"><div style="display:flex;align-items:center;justify-content:space-between;background:rgba(0,0,0,0.25);padding:0.65rem 0.85rem;border-radius:8px"><div><div style="font-size:0.82rem;color:#f8fafc;font-weight:600">ซ่อนจนกว่าจะกดเริ่ม</div><div style="font-size:0.7rem;color:#94a3b8">ไม่แสดงนาฬิกาล่วงหน้า</div></div><button style="padding:0.3rem 0.6rem;border-radius:6px;border:none;font-size:0.75rem;font-weight:700;cursor:pointer;background:#10b981;color:#000">เปิด (ON)</button></div><div style="display:flex;align-items:center;justify-content:space-between;background:rgba(0,0,0,0.25);padding:0.65rem 0.85rem;border-radius:8px"><div><div style="font-size:0.82rem;color:#f8fafc;font-weight:600">เริ่มนับเวลาออโต้</div><div style="font-size:0.7rem;color:#94a3b8">เมื่อเปิดคำถามสำเร็จ</div></div><button style="padding:0.3rem 0.6rem;border-radius:6px;border:none;font-size:0.75rem;font-weight:700;cursor:pointer;background:rgba(255,255,255,0.1);color:#94a3b8">ปิด (OFF)</button></div></div><div style="display:flex;align-items:center;justify-content:space-between;margin-top:0.75rem;padding-top:0.6rem;border-top:1px solid rgba(255,255,255,0.06)"><div style="display:flex;align-items:center;gap:0.35rem;font-size:0.82rem;color:#cbd5e1"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-type" aria-hidden="true"><path d="M12 4v16"></path><path d="M4 7V5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v2"></path><path d="M9 20h6"></path></svg><span>ขนาดตัวอักษรคำถามบนเวที:</span></div><div style="display:flex;gap:0.35rem"><button style="padding:0.25rem 0.6rem;border-radius:6px;font-size:0.75rem;font-weight:700;background:rgba(56, 189, 248, 0.25);border:1px solid #38bdf8;color:#7dd3fc;cursor:pointer">ปกติ</button><button style="padding:0.25rem 0.6rem;border-radius:6px;font-size:0.75rem;font-weight:500;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);color:#94a3b8;cursor:pointer">ใหญ่</button><button style="padding:0.25rem 0.6rem;border-radius:6px;font-size:0.75rem;font-weight:500;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);color:#94a3b8;cursor:pointer">ใหญ่พิเศษ</button></div></div></div><div style="background:rgba(14, 18, 44, 0.55);padding:1.25rem;border-radius:14px;border:1px solid rgba(255, 255, 255, 0.08)"><div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.9rem"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sliders-vertical lucide-sliders" aria-hidden="true"><path d="M10 8h4"></path><path d="M12 21v-9"></path><path d="M12 8V3"></path><path d="M17 16h4"></path><path d="M19 12V3"></path><path d="M19 21v-5"></path><path d="M3 14h4"></path><path d="M5 10V3"></path><path d="M5 21v-7"></path></svg><div><div style="color:#f8fafc;font-size:0.95rem;font-weight:600">เกณฑ์เวลาเตือนและช่วงวิกฤต (Alert Thresholds)</div><div style="color:#94a3b8;font-size:0.75rem">กำหนดวินาทีที่ระบบจะเปลี่ยนสีและส่งสัญญาณเตือน</div></div></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem"><div><div style="display:flex;justify-content:space-between;font-size:0.8rem;color:#fde68a;margin-bottom:0.35rem"><span>ช่วงเตือน (Warning):</span><strong>30<!-- --> วินาที</strong></div><input type="range" min="10" max="60" step="5" style="width:100%;accent-color:#f59e0b" value="30"/></div><div><div style="display:flex;justify-content:space-between;font-size:0.8rem;color:#fca5a5;margin-bottom:0.35rem"><span>ช่วงวิกฤต (Critical):</span><strong>10<!-- --> วินาที</strong></div><input type="range" min="3" max="20" step="1" style="width:100%;accent-color:#ef4444" value="10"/></div></div></div><div style="background:rgba(14, 18, 44, 0.65);padding:1.25rem;border-radius:14px;border:1px solid rgba(255, 255, 255, 0.09)"><div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:1rem"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-bell" aria-hidden="true"><path d="M10.268 21a2 2 0 0 0 3.464 0"></path><path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"></path></svg><div><div style="color:#f8fafc;font-size:0.95rem;font-weight:600">ระบบเสียงตัวจับเวลา (Timer Audio Controls)</div><div style="color:#94a3b8;font-size:0.75rem">ตั้งค่าเปิด/ปิดเสียงติ๊ก, เสียงเตือนใกล้หมด และเสียงเมื่อหมดเวลา (Sync สู่เวทีแบบ Realtime)</div></div></div><div style="display:flex;flex-direction:column;gap:0.65rem"><div style="display:flex;align-items:center;justify-content:space-between;background:rgba(0, 0, 0, 0.25);padding:0.65rem 0.85rem;border-radius:8px"><div><div style="font-size:0.84rem;color:#f8fafc;font-weight:600;display:flex;align-items:center;gap:0.35rem"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg> เสียงติ๊กนับถอยหลัง (Countdown Ticks)</div><div style="font-size:0.72rem;color:#94a3b8">เสียงติ๊กเบาๆ ทุกวินาทีตามจังหวะเวลาปกติ</div></div><button type="button" style="padding:0.35rem 0.75rem;border-radius:6px;border:none;font-size:0.75rem;font-weight:700;cursor:pointer;background:#10b981;color:#000;transition:all 0.2s">เปิด (ON)</button></div><div style="display:flex;align-items:center;justify-content:space-between;background:rgba(0, 0, 0, 0.25);padding:0.65rem 0.85rem;border-radius:8px"><div><div style="font-size:0.84rem;color:#f8fafc;font-weight:600;display:flex;align-items:center;gap:0.35rem"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-triangle-alert lucide-alert-triangle" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg> เสียงเตือนช่วงใกล้หมดเวลา (Warning / Critical)</div><div style="font-size:0.72rem;color:#94a3b8">เสียงเตือนพิเศษช่วงวิกฤต (≤10s) และ 3 วินาทีสุดท้าย</div></div><button type="button" style="padding:0.35rem 0.75rem;border-radius:6px;border:none;font-size:0.75rem;font-weight:700;cursor:pointer;background:#f59e0b;color:#000;transition:all 0.2s">เปิด (ON)</button></div><div style="display:flex;align-items:center;justify-content:space-between;background:rgba(0, 0, 0, 0.25);padding:0.65rem 0.85rem;border-radius:8px"><div><div style="font-size:0.84rem;color:#f8fafc;font-weight:600;display:flex;align-items:center;gap:0.35rem"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-flame" aria-hidden="true"><path d="M12 3q1 4 4 6.5t3 5.5a1 1 0 0 1-14 0 5 5 0 0 1 1-3 1 1 0 0 0 5 0c0-2-1.5-3-1.5-5q0-2 2.5-4"></path></svg> เสียงสัญญาณเมื่อหมดเวลา (Timeout Finish Gong)</div><div style="font-size:0.72rem;color:#94a3b8">เสียงระฆังแจ้งเตือนเมื่อนับถึง 00:00</div></div><button type="button" style="padding:0.35rem 0.75rem;border-radius:6px;border:none;font-size:0.75rem;font-weight:700;cursor:pointer;background:#ef4444;color:#fff;transition:all 0.2s">เปิด (ON)</button></div></div><div style="margin-top:0.9rem;padding-top:0.8rem;border-top:1px solid rgba(255, 255, 255, 0.08)"><div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.6rem"><span style="font-size:0.8rem;color:#94a3b8;min-width:95px">ระดับความดังเสียง:</span><input type="range" min="0" max="1" step="0.05" style="flex:1;accent-color:#38bdf8" value="0.6"/><span style="font-size:0.8rem;color:#cbd5e1;min-width:40px;text-align:right;font-weight:600">60<!-- -->%</span></div><div style="display:flex;align-items:center;gap:0.4rem;justify-content:flex-end;flex-wrap:wrap"><span style="font-size:0.75rem;color:#94a3b8;margin-right:auto">ทดสอบเสียงตัวอย่าง:</span><button type="button" style="padding:0.25rem 0.55rem;background:rgba(56, 189, 248, 0.12);border:1px solid rgba(56, 189, 248, 0.3);border-radius:6px;color:#7dd3fc;font-size:0.74rem;cursor:pointer">ติ๊กปกติ</button><button type="button" style="padding:0.25rem 0.55rem;background:rgba(245, 158, 11, 0.15);border:1px solid rgba(245, 158, 11, 0.35);border-radius:6px;color:#fde68a;font-size:0.74rem;cursor:pointer">เตือน 3 วินาที</button><button type="button" style="padding:0.25rem 0.55rem;background:rgba(239, 68, 68, 0.15);border:1px solid rgba(239, 68, 68, 0.35);border-radius:6px;color:#fca5a5;font-size:0.74rem;cursor:pointer">หมดเวลา</button></div></div></div><div style="background:rgba(14, 18, 44, 0.5);padding:1.25rem;border-radius:12px;border:1px solid rgba(255, 255, 255, 0.08)"><h4 style="margin:0 0 0.75rem 0;color:#f8fafc;font-size:0.9rem;display:flex;align-items:center;gap:0.4rem"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#eab308" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-zap" aria-hidden="true"><path d="M15.914 4a1.5 1.5 0 00-2.474-1.561l-9 9A1.5 1.5 0 005.5 14h4.002a.5.5 0 01.471.666L8.086 20a1.5 1.5 0 002.475 1.56l9-9A1.5 1.5 0 0018.5 10h-3.997a.5.5 0 01-.472-.667z"></path></svg> ค่าเวลามาตรฐาน (Presets)</h4><div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(130px, 1fr));gap:0.6rem"><button style="padding:0.75rem 0.6rem;background:rgba(255, 255, 255, 0.03);border:1px solid rgba(255, 255, 255, 0.08);border-radius:8px;color:#cbd5e1;cursor:pointer;text-align:center;transition:all 0.2s"><div style="font-size:1.1rem;font-weight:700">30s</div><div style="font-size:0.7rem;color:#94a3b8;margin-top:0.2rem">Quick / ซักถามด่วน</div></button><button style="padding:0.75rem 0.6rem;background:rgba(124, 58, 237, 0.2);border:1px solid var(--ctl-accent);border-radius:8px;color:var(--ctl-accent-pale);cursor:pointer;text-align:center;transition:all 0.2s"><div style="font-size:1.1rem;font-weight:700">1m</div><div style="font-size:0.7rem;color:#94a3b8;margin-top:0.2rem">Short / รอบทั่วไป</div></button><button style="padding:0.75rem 0.6rem;background:rgba(255, 255, 255, 0.03);border:1px solid rgba(255, 255, 255, 0.08);border-radius:8px;color:#cbd5e1;cursor:pointer;text-align:center;transition:all 0.2s"><div style="font-size:1.1rem;font-weight:700">1m 30s</div><div style="font-size:0.7rem;color:#94a3b8;margin-top:0.2rem">Standard / มาตรฐาน</div></button><button style="padding:0.75rem 0.6rem;background:rgba(255, 255, 255, 0.03);border:1px solid rgba(255, 255, 255, 0.08);border-radius:8px;color:#cbd5e1;cursor:pointer;text-align:center;transition:all 0.2s"><div style="font-size:1.1rem;font-weight:700">2m</div><div style="font-size:0.7rem;color:#94a3b8;margin-top:0.2rem">Final / รอบตัดสิน</div></button></div></div><form style="background:rgba(14, 18, 44, 0.5);padding:1.25rem;border-radius:12px;border:1px solid rgba(255, 255, 255, 0.08);display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap"><span style="color:#cbd5e1;font-size:0.85rem;display:flex;align-items:center;gap:0.35rem"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg> กำหนดเวลาเอง:</span><div style="display:flex;align-items:center;gap:0.35rem"><input type="number" min="0" max="59" style="width:55px;padding:0.4rem;background:rgba(0,0,0,0.5);border:1px solid rgba(255,255,255,0.15);border-radius:6px;color:#fff;text-align:center" value="1"/><span style="color:#94a3b8">นาที</span></div><div style="display:flex;align-items:center;gap:0.35rem"><input type="number" min="0" max="59" style="width:55px;padding:0.4rem;background:rgba(0,0,0,0.5);border:1px solid rgba(255,255,255,0.15);border-radius:6px;color:#fff;text-align:center" value="30"/><span style="color:#94a3b8">วินาที</span></div><button type="submit" style="padding:0.45rem 1rem;background:rgba(255, 255, 255, 0.1);border:1px solid rgba(255, 255, 255, 0.2);border-radius:6px;color:#fff;font-size:0.85rem;cursor:pointer">ตั้งค่าเวลานี้</button></form></div>"`;
