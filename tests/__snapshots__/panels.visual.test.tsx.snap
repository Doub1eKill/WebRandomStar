// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`split panels render the same markup > AppearanceSettingsPanel (defaults) 1`] = `"<div class="appearance-settings-panel"><div class="control-section-group"><h3 class="group-title"><span class="group-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trophy" aria-hidden="true"><path d="M10 14.66V17a1 1 0 0 1-1 1 2 2 0 0 0-2 2v2"></path><path d="M14 14.66V17a1 1 0 0 0 1 1 2 2 0 0 1 2 2v2"></path><path d="M17.916 10H19.5A2.5 2.5 0 0 0 22 7.5V5a1 1 0 0 0-1-1h-3"></path><path d="M4 22h16"></path><path d="M6 9a6 6 0 0 0 12 0V3a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1z"></path><path d="M6.084 10H4.5A2.5 2.5 0 0 1 2 7.5V5a1 1 0 0 1 1-1h3"></path></svg></span><span>รูปแบบการแข่งขันบนเวที (Competition Flow Mode)</span></h3><p class="ui-group-hint">เลือกรูปแบบขั้นตอนการแข่งขัน: สุ่มเฉพาะคำสำคัญเพื่อแสดงการ์ดคำพร้อมจับเวลาตอบสด หรือสุ่มเปิดคลังคำถามเต็มรูปแบบ</p><div class="mode-selection-grid ui-mode-grid"><button type="button" data-testid="quiz-mode-question" class="mode-card active"><span class="mode-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open" aria-hidden="true"><path d="M12 5v16"></path><path d="M20.001 19A2 2 0 0022 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z"></path></svg></span><div class="mode-info"><div class="ui-mode-head"><span class="mode-name ui-mode-name">โหมดสุ่มคลังคำถาม</span><span class="ui-badge ui-badge--sky">มาตรฐาน</span></div><span class="mode-desc ui-mode-desc">สุ่มดึงคำถามจากคลังคำถามของรอบที่เลือก → เปิดการ์ดคำถามเต็มพร้อมจับเวลา</span></div></button><button type="button" data-testid="quiz-mode-keyword" class="mode-card "><span class="mode-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-tag" aria-hidden="true"><path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"></path><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"></circle></svg></span><div class="mode-info"><div class="ui-mode-head"><span class="mode-name ui-mode-name">โหมดสุ่มคำสำคัญ</span><span class="ui-badge ui-badge--violet">สุนทรพจน์ / คีย์เวิร์ด</span></div><span class="mode-desc ui-mode-desc">สุ่มเฉพาะคำสำคัญ → แสดงการ์ดคำสำคัญประกายแสงขนาดใหญ่ (Showcase) → เริ่มจับเวลาตอบคำถามทันที</span></div></button></div></div><div class="control-section-group"><h3 class="group-title"><span class="group-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-image" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path></svg></span><span>รูปแบบพื้นหลังเวทีหลัก (Stage Background Mode)</span></h3><p class="ui-group-hint">เลือกสลับระหว่างพื้นหลังเนบิวลาคริสตัลปัจจุบัน และพื้นหลังประติมากรรมแก้ว 3D AeroShards (สลับได้ทันทีแบบ Real-time)</p><div class="mode-selection-grid ui-mode-grid"><button type="button" class="mode-card active"><span class="mode-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-orbit" aria-hidden="true"><path d="M20.341 6.484A10 10 0 0 1 10.266 21.85"></path><path d="M3.659 17.516A10 10 0 0 1 13.74 2.152"></path><circle cx="12" cy="12" r="3"></circle><circle cx="19" cy="5" r="2"></circle><circle cx="5" cy="19" r="2"></circle></svg></span><div class="mode-info"><div class="ui-mode-head"><span class="mode-name ui-mode-name">Cosmic Canvas Stage</span><span class="ui-badge ui-badge--sky">มาตรฐาน</span></div><span class="mode-desc ui-mode-desc">ฟ้าราตรีเนบิวลา ออโรร่าระยิบระยับ ละอองคริสตัล และมงกุฎแสง (Canvas 2D นิ่งเสถียร 60fps)</span></div></button><button type="button" class="mode-card "><span class="mode-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-gem" aria-hidden="true"><path d="M10.5 3 8 9l4 13 4-13-2.5-6"></path><path d="M17 3a2 2 0 0 1 1.6.8l3 4a2 2 0 0 1 .013 2.382l-7.99 10.986a2 2 0 0 1-3.247 0l-7.99-10.986A2 2 0 0 1 2.4 7.8l2.998-3.997A2 2 0 0 1 7 3z"></path><path d="M2 9h20"></path></svg></span><div class="mode-info"><div class="ui-mode-head"><span class="mode-name ui-mode-name">AeroShards Glass Sculpture</span><span class="ui-badge ui-badge--violet">ใหม่ 3D</span></div><span class="mode-desc ui-mode-desc">ประติมากรรมเศษแก้วคริสตัล 3D สไตล์ React Bits AeroShards ในโทนสีม่วงคริสตัล-ฟ้าสว่าง คุมธีม 100%</span></div></button></div></div><div class="control-section-group"><h3 class="group-title"><span class="group-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-type" aria-hidden="true"><path d="M12 4v16"></path><path d="M4 7V5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v2"></path><path d="M9 20h6"></path></svg></span><span>รูปแบบตัวอักษรและฟอนต์ (Typography &amp; Font Selection)</span></h3><p class="ui-group-hint">เลือกฟอนต์หลักของเวทีสำหรับหัวข้อ คำสำคัญ และการ์ดคำถาม (ภาษาไทยจะจับคู่กับ Prompt เสมอเพื่อความคมชัด)</p><div class="font-preset-grid"><button type="button" data-testid="font-card-cinzel" class="font-preset-card active"><div class="font-card-header"><span class="font-name">Cinzel</span><span class="font-badge badge-royal">Royal Standard</span></div><div class="font-author">Natanael Gama / Google Fonts</div><div class="font-preview-sample" style="font-family:&#x27;Cinzel&#x27;, Georgia, &#x27;Prompt&#x27;, serif">CHARM OF TRANSITION 2026 — มนต์เสน่ห์แห่งรอยต่อฤดู</div><div class="font-desc">ฟอนต์โรมันคลาสสิก ลายเส้นทรงเกียรติยศ มาตรฐานเวทีประกวดระดับสากล</div></button><button type="button" data-testid="font-card-amoria" class="font-preset-card "><div class="font-card-header"><span class="font-name">Playfair Display</span><span class="font-badge badge-luxury">Modern Luxury</span></div><div class="font-author">Claus Eggers Sørensen / Google Fonts</div><div class="font-preview-sample" style="font-family:&#x27;Playfair Display&#x27;, &#x27;Cinzel&#x27;, &#x27;Prompt&#x27;, serif">CHARM OF TRANSITION 2026 — มนต์เสน่ห์แห่งรอยต่อฤดู</div><div class="font-desc">ฟอนต์สไตล์ High-Fashion โมเดิร์นหรูหรา ลายเส้นคมชัด สง่างามเหนือระดับ</div></button><button type="button" data-testid="font-card-verve" class="font-preset-card "><div class="font-card-header"><span class="font-name">Cinzel Decorative</span><span class="font-badge badge-heritage">Classic Heritage</span></div><div class="font-author">Natanael Gama / Google Fonts</div><div class="font-preview-sample" style="font-family:&#x27;Cinzel Decorative&#x27;, &#x27;Cinzel&#x27;, &#x27;Prompt&#x27;, serif">CHARM OF TRANSITION 2026 — มนต์เสน่ห์แห่งรอยต่อฤดู</div><div class="font-desc">ฟอนต์คลาสสิกวิจิตร ศิลปะลวดลายโบราณ เอกลักษณ์โดดเด่นสะกดทุกสายตา</div></button><button type="button" data-testid="font-card-outfit" class="font-preset-card "><div class="font-card-header"><span class="font-name">Outfit</span><span class="font-badge badge-modern">Modern Sans</span></div><div class="font-author">Outfit / Google Fonts</div><div class="font-preview-sample" style="font-family:&#x27;Outfit&#x27;, &#x27;Prompt&#x27;, sans-serif">CHARM OF TRANSITION 2026 — มนต์เสน่ห์แห่งรอยต่อฤดู</div><div class="font-desc">ฟอนต์โมเดิร์นคลีน ไร้หัว อ่านง่าย สบายตา ทันสมัยและกระชับ</div></button><button type="button" data-testid="font-card-custom" class="font-preset-card "><div class="font-card-header"><span class="font-name">Custom WebFont</span><span class="font-badge badge-custom">กำหนดเอง</span></div><div class="font-author">เพิ่มฟอนต์ Google Fonts / WebFont</div><div class="font-preview-sample" style="font-family:sans-serif">CHARM OF TRANSITION 2026 — มนต์เสน่ห์แห่งรอยต่อฤดู</div><div class="font-desc">ปรับแต่งและใส่ฟอนต์ใหม่ตามต้องการผ่าน Google Fonts URL หรือ Custom Font Family</div></button></div></div><div class="control-section-group"><h3 class="group-title"><span class="group-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-crown" aria-hidden="true"><path d="M11.562 3.266a.5.5 0 0 1 .876 0L15.39 8.87a1 1 0 0 0 1.516.294L21.183 5.5a.5.5 0 0 1 .798.519l-2.834 10.246a1 1 0 0 1-.956.734H5.81a1 1 0 0 1-.957-.734L2.02 6.02a.5.5 0 0 1 .798-.519l4.276 3.664a1 1 0 0 0 1.516-.294z"></path><path d="M5 21h14"></path></svg></span><span>รูปแบบการหมุนคำสำคัญ (Word Spin Mode)</span></h3><div class="mode-selection-grid"><button type="button" class="mode-card active"><span class="mode-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-gallery-vertical" aria-hidden="true"><path d="M3 2h18"></path><rect width="18" height="12" x="3" y="6" rx="2"></rect><path d="M3 22h18"></path></svg></span><div class="mode-info"><span class="mode-name">Royal Vertical Spin</span><span class="mode-desc">คำเลื่อนผ่านแกนกลางแนวตั้งสไตล์ Royal Reel (แนะนำ)</span></div></button><button type="button" class="mode-card "><span class="mode-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-box" aria-hidden="true"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path><path d="m3.3 7 8.7 5 8.7-5"></path><path d="M12 22V12"></path></svg></span><div class="mode-info"><span class="mode-name">3D Perspective Spin</span><span class="mode-desc">คำหมุนบนระนาบ 3D มิติความลึกและ Blur</span></div></button><button type="button" class="mode-card "><span class="mode-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-orbit" aria-hidden="true"><path d="M20.341 6.484A10 10 0 0 1 10.266 21.85"></path><path d="M3.659 17.516A10 10 0 0 1 13.74 2.152"></path><circle cx="12" cy="12" r="3"></circle><circle cx="19" cy="5" r="2"></circle><circle cx="5" cy="19" r="2"></circle></svg></span><div class="mode-info"><span class="mode-name">Circular Orbital Words</span><span class="mode-desc">คำหมุนวนรอบศูนย์กลางก่อนล็อกกึ่งกลาง</span></div></button><button type="button" class="mode-card "><span class="mode-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-ribbon" aria-hidden="true"><path d="M12 11.22C11 9.997 10 9 10 8a2 2 0 0 1 4 0c0 1-.998 2.002-2.01 3.22"></path><path d="m12 18 2.57-3.5"></path><path d="M6.243 9.016a7 7 0 0 1 11.507-.009"></path><path d="M9.35 14.53 12 11.22"></path><path d="M9.35 14.53C7.728 12.246 6 10.221 6 7a6 5 0 0 1 12 0c-.005 3.22-1.778 5.235-3.43 7.5l3.557 4.527a1 1 0 0 1-.203 1.43l-1.894 1.36a1 1 0 0 1-1.384-.215L12 18l-2.679 3.593a1 1 0 0 1-1.39.213l-1.865-1.353a1 1 0 0 1-.203-1.422z"></path></svg></span><div class="mode-info"><span class="mode-name">Royal Ribbon Spin</span><span class="mode-desc">ริบบิ้นแก้วแสงประกายเลื่อนผ่านคำ</span></div></button></div></div><div class="control-section-group"><h3 class="group-title"><span class="group-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-timer" aria-hidden="true"><line x1="10" x2="14" y1="2" y2="2"></line><line x1="12" x2="15" y1="14" y2="11"></line><circle cx="12" cy="14" r="8"></circle></svg></span><span>รูปแบบการหยุดสุ่มคำ (Word Spin Stop Mode)</span></h3><p class="ui-group-hint">เลือกระหว่างการสุ่มและหยุดล็อกคำอัตโนมัติ หรือสุ่มต่อเนื่องจนกว่าจะกดปุ่มหยุด</p><div class="mode-selection-grid ui-mode-grid"><button type="button" data-testid="spin-stop-card-auto" class="mode-card active"><span class="mode-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-hourglass" aria-hidden="true"><path d="M5 22h14"></path><path d="M5 2h14"></path><path d="M17 22v-4.172a2 2 0 0 0-.586-1.414L12 12l-4.414 4.414A2 2 0 0 0 7 17.828V22"></path><path d="M7 2v4.172a2 2 0 0 0 .586 1.414L12 12l4.414-4.414A2 2 0 0 0 17 6.172V2"></path></svg></span><div class="mode-info"><div class="ui-mode-head"><span class="mode-name ui-mode-name">หยุดอัตโนมัติ (Auto-Stop)</span><span class="ui-badge ui-badge--sky">ค่าเริ่มต้น</span></div><span class="mode-desc ui-mode-desc">หมุนตามเวลาที่กำหนด (4.5 วินาที) แล้วเริ่มชะลอหยุดและล็อกคำที่สุ่มได้อัตโนมัติ</span></div></button><button type="button" data-testid="spin-stop-card-manual" class="mode-card "><span class="mode-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-octagon-x lucide-x-octagon" aria-hidden="true"><path d="m15 9-6 6"></path><path d="M2.586 16.726A2 2 0 0 1 2 15.312V8.688a2 2 0 0 1 .586-1.414l4.688-4.688A2 2 0 0 1 8.688 2h6.624a2 2 0 0 1 1.414.586l4.688 4.688A2 2 0 0 1 22 8.688v6.624a2 2 0 0 1-.586 1.414l-4.688 4.688a2 2 0 0 1-1.414.586H8.688a2 2 0 0 1-1.414-.586z"></path><path d="m9 9 6 6"></path></svg></span><div class="mode-info"><div class="ui-mode-head"><span class="mode-name ui-mode-name">หยุดด้วยตนเอง (Manual Stop)</span><span class="ui-badge ui-badge--red">ควบคุมสด</span></div><span class="mode-desc ui-mode-desc">คำหมุนต่อเนื่อง 60fps ไปเรื่อยๆ จนกว่าพิธีกร/แอดมินจะกดปุ่ม STOP หรือ Spacebar จึงจะเริ่มชะลอและล็อกคำ</span></div></button></div></div><div class="control-section-group"><h3 class="group-title"><span class="group-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-music" aria-hidden="true"><path d="M9 18V5l12-2v13"></path><circle cx="6" cy="18" r="3"></circle><circle cx="18" cy="16" r="3"></circle></svg></span><span>เพลง/เสียงประกอบช่วงสุ่มคำ (Word Spin Audio Track)</span></h3><p class="ui-group-hint">เลือกเพลงหรือเสียงระทึกช่วงสุ่มคำ สามารถอัปโหลดไฟล์เสียงใหม่ (MP3/WAV) หรือทดลองฟังเสียงได้ทันที</p><div style="background:rgba(14, 18, 44, 0.7);border:1px solid rgba(245, 158, 11, 0.25);border-radius:12px;padding:14px"><div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:8px"><div style="flex:1;min-width:220px"><label style="display:block;font-size:0.75rem;color:#cbd5e1;margin-bottom:4px">เสียงเพลงประจำช่วงสุ่ม (Spin Phase Audio)</label><select style="width:100%;padding:8px 12px;background:#0f172a;border:1px solid rgba(245, 158, 11, 0.4);border-radius:6px;color:#fff;font-size:0.85rem"><option value="">-- ไม่เปิดเพลง (ปิดเสียง) --</option><option value="preset-ambient-luxury">Royalty Ambient Pad (ประกายแสงราตรี)<!-- --> <!-- -->(เพลงระบบ)</option><option value="preset-spin-tension">Suspense Pulse (ลุ้นระทึกหมุนคำ)<!-- --> <!-- -->(เพลงระบบ)</option><option value="preset-question-focus">Focus Chrono Flow (สมาธิคิดคำตอบ)<!-- --> <!-- -->(เพลงระบบ)</option><option value="preset-fanfare-royal">Victory Crown Fanfare (เฉลิมฉลองชัยชนะ)<!-- --> <!-- -->(เพลงระบบ)</option><option value="custom-1" selected="">My Song<!-- --> <!-- -->(อัปโหลดเอง)</option></select></div><div style="display:flex;gap:8px;align-items:flex-end;margin-top:16px"><button type="button" class="btn-secondary" style="padding:8px 14px;font-size:0.82rem"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-play" aria-hidden="true"><path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"></path></svg> ฟังตัวอย่าง</button><input type="file" accept="audio/*" style="display:none"/><button type="button" class="btn-primary" style="padding:8px 14px;font-size:0.82rem;background:linear-gradient(135deg, #d97706, #b45309);border-color:#f59e0b"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-upload" aria-hidden="true"><path d="M12 3v12"></path><path d="m17 8-5-5-5 5"></path><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path></svg> อัปโหลดเสียงสุ่ม (MP3/WAV)</button><button type="button" class="btn-secondary btn-danger-soft" style="padding:8px 12px;font-size:0.82rem" title="ลบเพลงที่อัปโหลดนี้ออกจากระบบ"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash lucide-trash-2" aria-hidden="true"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg> ลบเพลง</button></div></div><div style="font-size:0.75rem;color:#94a3b8;display:flex;align-items:center;gap:8px;margin-top:4px"><span>ความยาว: <!-- -->125<!-- -->s</span><span>•</span><span class="ui-ico-label">สถานะ: <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-folder" aria-hidden="true"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg> ไฟล์เสียงที่อัปโหลดเอง</span></div></div></div><div class="control-section-group"><h3 class="group-title"><span class="group-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-gallery-vertical-end" aria-hidden="true"><path d="M7 2h10"></path><path d="M5 6h14"></path><rect width="18" height="12" x="3" y="10" rx="2"></rect></svg></span><span>ช่วงแสดงการ์ดคำที่สุ่มได้ (Selected Keyword Showcase)</span></h3><p class="ui-group-hint">เลือกว่าจะแสดงหน้าต่างการ์ดสรุปคำสำคัญที่สุ่มได้ (SELECTED KEYWORD) คั่นกลางก่อนเปิดการ์ดคำถามหรือไม่</p><div class="mode-selection-grid ui-mode-grid"><button type="button" data-testid="word-lock-card-on" class="mode-card active"><span class="mode-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles lucide-stars" aria-hidden="true"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"></path><path d="M20 2v4"></path><path d="M22 4h-4"></path><circle cx="4" cy="20" r="2"></circle></svg></span><div class="mode-info"><div class="ui-mode-head"><span class="mode-name ui-mode-name">เปิดใช้งาน (ON)</span><span class="ui-badge ui-badge--sky">ค่าเริ่มต้น</span></div><span class="mode-desc ui-mode-desc">เมื่อหยุดสุ่ม จะแสดงการ์ดคำสำคัญเด่นชัดกลางจอก่อน 1.5 วินาที แล้วจึงเปิดการ์ดคำถาม</span></div></button><button type="button" data-testid="word-lock-card-off" class="mode-card "><span class="mode-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-zap" aria-hidden="true"><path d="M15.914 4a1.5 1.5 0 00-2.474-1.561l-9 9A1.5 1.5 0 005.5 14h4.002a.5.5 0 01.471.666L8.086 20a1.5 1.5 0 002.475 1.56l9-9A1.5 1.5 0 0018.5 10h-3.997a.5.5 0 01-.472-.667z"></path></svg></span><div class="mode-info"><div class="ui-mode-head"><span class="mode-name ui-mode-name">ข้ามช่วงนี้ (OFF)</span><span class="ui-badge ui-badge--red">สตรีมกระชับ</span></div><span class="mode-desc ui-mode-desc">เมื่อหยุดสุ่ม จะข้ามไปเปิดการ์ดคำถามทันทีโดยไม่ต้องรอแสดงการ์ดคำคั่น</span></div></button></div></div><div class="control-section-group"><h3 class="group-title"><span class="group-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles lucide-stars" aria-hidden="true"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"></path><path d="M20 2v4"></path><path d="M22 4h-4"></path><circle cx="4" cy="20" r="2"></circle></svg></span><span>บรรยากาศเวทีและแสงสี (Atmospheric Layers &amp; FX)</span></h3><div class="toggles-grid"><label class="toggle-switch-card"><input type="checkbox" checked=""/><div class="toggle-card-content"><span class="toggle-title ui-ico-label"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-crown" aria-hidden="true"><path d="M11.562 3.266a.5.5 0 0 1 .876 0L15.39 8.87a1 1 0 0 0 1.516.294L21.183 5.5a.5.5 0 0 1 .798.519l-2.834 10.246a1 1 0 0 1-.956.734H5.81a1 1 0 0 1-.957-.734L2.02 6.02a.5.5 0 0 1 .798-.519l4.276 3.664a1 1 0 0 0 1.516-.294z"></path><path d="M5 21h14"></path></svg>เงาประกายมงกุฎ (Crown Silhouette)</span><span class="toggle-desc">แสดงลายน้ำมงกุฎคริสตัลโปร่งแสงกึ่งกลางเวที</span></div></label><label class="toggle-switch-card"><input type="checkbox" checked=""/><div class="toggle-card-content"><span class="toggle-title ui-ico-label"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-waves-horizontal lucide-waves" aria-hidden="true"><path d="M2 12q2.5 2 5 0t5 0 5 0 5 0"></path><path d="M2 19q2.5 2 5 0t5 0 5 0 5 0"></path><path d="M2 5q2.5 2 5 0t5 0 5 0 5 0"></path></svg>แสงสะท้อนผิวน้ำ (Water Reflection)</span><span class="toggle-desc">ผิวน้ำสะท้อนแสงไฟและเวทีที่ขอบจอด้านล่าง</span></div></label><label class="toggle-switch-card"><input type="checkbox" checked=""/><div class="toggle-card-content"><span class="toggle-title ui-ico-label"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles lucide-stars" aria-hidden="true"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"></path><path d="M20 2v4"></path><path d="M22 4h-4"></path><circle cx="4" cy="20" r="2"></circle></svg>ม่านแสงออโรร่า (Aurora Glow)</span><span class="toggle-desc">ริ้วคลื่นแสงสีน้ำเงิน-ม่วงพลิ้วไหว</span></div></label><label class="toggle-switch-card"><input type="checkbox" checked=""/><div class="toggle-card-content"><span class="toggle-title ui-ico-label"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-gem" aria-hidden="true"><path d="M10.5 3 8 9l4 13 4-13-2.5-6"></path><path d="M17 3a2 2 0 0 1 1.6.8l3 4a2 2 0 0 1 .013 2.382l-7.99 10.986a2 2 0 0 1-3.247 0l-7.99-10.986A2 2 0 0 1 2.4 7.8l2.998-3.997A2 2 0 0 1 7 3z"></path><path d="M2 9h20"></path></svg>ฝุ่นคริสตัลและโบเก้ (Floating Crystals)</span><span class="toggle-desc">ละอองประกายคริสตัลระยิบระยับลอยตัว</span></div></label></div></div><div class="control-section-group"><h3 class="group-title"><span class="group-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sliders-horizontal" aria-hidden="true"><path d="M10 5H3"></path><path d="M12 19H3"></path><path d="M14 3v4"></path><path d="M16 17v4"></path><path d="M21 12h-9"></path><path d="M21 19h-5"></path><path d="M21 5h-7"></path><path d="M8 10v4"></path><path d="M8 12H3"></path></svg></span><span>ความเข้มของแสงและอนุภาค (Density &amp; Glow Intensity)</span></h3><div class="sliders-panel"><div class="slider-row"><div class="slider-header"><span class="slider-label">ความหนาแน่นของคริสตัล (Crystal Density)</span><span class="slider-value">100<!-- -->%</span></div><input type="range" min="0.2" max="2.0" step="0.1" class="range-slider" value="1"/></div><div class="slider-row"><div class="slider-header"><span class="slider-label">ความสว่างของแสงออโรร่า (Glow Intensity)</span><span class="slider-value">100<!-- -->%</span></div><input type="range" min="0.2" max="2.0" step="0.1" class="range-slider" value="1"/></div></div><div class="section-reset-row" style="margin-top:16px"><button type="button" class="btn-secondary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-ccw" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg> รีเซ็ตค่าการแสดงผลเริ่มต้น</button></div></div></div>"`;

exports[`split panels render the same markup > AppearanceSettingsPanel (keyword, manual stop, custom font) 1`] = `"<div class="appearance-settings-panel"><div class="control-section-group"><h3 class="group-title"><span class="group-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trophy" aria-hidden="true"><path d="M10 14.66V17a1 1 0 0 1-1 1 2 2 0 0 0-2 2v2"></path><path d="M14 14.66V17a1 1 0 0 0 1 1 2 2 0 0 1 2 2v2"></path><path d="M17.916 10H19.5A2.5 2.5 0 0 0 22 7.5V5a1 1 0 0 0-1-1h-3"></path><path d="M4 22h16"></path><path d="M6 9a6 6 0 0 0 12 0V3a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1z"></path><path d="M6.084 10H4.5A2.5 2.5 0 0 1 2 7.5V5a1 1 0 0 1 1-1h3"></path></svg></span><span>รูปแบบการแข่งขันบนเวที (Competition Flow Mode)</span></h3><p class="ui-group-hint">เลือกรูปแบบขั้นตอนการแข่งขัน: สุ่มเฉพาะคำสำคัญเพื่อแสดงการ์ดคำพร้อมจับเวลาตอบสด หรือสุ่มเปิดคลังคำถามเต็มรูปแบบ</p><div class="mode-selection-grid ui-mode-grid"><button type="button" data-testid="quiz-mode-question" class="mode-card "><span class="mode-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open" aria-hidden="true"><path d="M12 5v16"></path><path d="M20.001 19A2 2 0 0022 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z"></path></svg></span><div class="mode-info"><div class="ui-mode-head"><span class="mode-name ui-mode-name">โหมดสุ่มคลังคำถาม</span><span class="ui-badge ui-badge--sky">มาตรฐาน</span></div><span class="mode-desc ui-mode-desc">สุ่มดึงคำถามจากคลังคำถามของรอบที่เลือก → เปิดการ์ดคำถามเต็มพร้อมจับเวลา</span></div></button><button type="button" data-testid="quiz-mode-keyword" class="mode-card active"><span class="mode-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-tag" aria-hidden="true"><path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"></path><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"></circle></svg></span><div class="mode-info"><div class="ui-mode-head"><span class="mode-name ui-mode-name">โหมดสุ่มคำสำคัญ</span><span class="ui-badge ui-badge--violet">สุนทรพจน์ / คีย์เวิร์ด</span></div><span class="mode-desc ui-mode-desc">สุ่มเฉพาะคำสำคัญ → แสดงการ์ดคำสำคัญประกายแสงขนาดใหญ่ (Showcase) → เริ่มจับเวลาตอบคำถามทันที</span></div></button></div></div><div class="control-section-group"><h3 class="group-title"><span class="group-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-image" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path></svg></span><span>รูปแบบพื้นหลังเวทีหลัก (Stage Background Mode)</span></h3><p class="ui-group-hint">เลือกสลับระหว่างพื้นหลังเนบิวลาคริสตัลปัจจุบัน และพื้นหลังประติมากรรมแก้ว 3D AeroShards (สลับได้ทันทีแบบ Real-time)</p><div class="mode-selection-grid ui-mode-grid"><button type="button" class="mode-card "><span class="mode-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-orbit" aria-hidden="true"><path d="M20.341 6.484A10 10 0 0 1 10.266 21.85"></path><path d="M3.659 17.516A10 10 0 0 1 13.74 2.152"></path><circle cx="12" cy="12" r="3"></circle><circle cx="19" cy="5" r="2"></circle><circle cx="5" cy="19" r="2"></circle></svg></span><div class="mode-info"><div class="ui-mode-head"><span class="mode-name ui-mode-name">Cosmic Canvas Stage</span><span class="ui-badge ui-badge--sky">มาตรฐาน</span></div><span class="mode-desc ui-mode-desc">ฟ้าราตรีเนบิวลา ออโรร่าระยิบระยับ ละอองคริสตัล และมงกุฎแสง (Canvas 2D นิ่งเสถียร 60fps)</span></div></button><button type="button" class="mode-card active"><span class="mode-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-gem" aria-hidden="true"><path d="M10.5 3 8 9l4 13 4-13-2.5-6"></path><path d="M17 3a2 2 0 0 1 1.6.8l3 4a2 2 0 0 1 .013 2.382l-7.99 10.986a2 2 0 0 1-3.247 0l-7.99-10.986A2 2 0 0 1 2.4 7.8l2.998-3.997A2 2 0 0 1 7 3z"></path><path d="M2 9h20"></path></svg></span><div class="mode-info"><div class="ui-mode-head"><span class="mode-name ui-mode-name">AeroShards Glass Sculpture</span><span class="ui-badge ui-badge--violet">ใหม่ 3D</span></div><span class="mode-desc ui-mode-desc">ประติมากรรมเศษแก้วคริสตัล 3D สไตล์ React Bits AeroShards ในโทนสีม่วงคริสตัล-ฟ้าสว่าง คุมธีม 100%</span></div></button></div></div><div class="control-section-group"><h3 class="group-title"><span class="group-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-type" aria-hidden="true"><path d="M12 4v16"></path><path d="M4 7V5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v2"></path><path d="M9 20h6"></path></svg></span><span>รูปแบบตัวอักษรและฟอนต์ (Typography &amp; Font Selection)</span></h3><p class="ui-group-hint">เลือกฟอนต์หลักของเวทีสำหรับหัวข้อ คำสำคัญ และการ์ดคำถาม (ภาษาไทยจะจับคู่กับ Prompt เสมอเพื่อความคมชัด)</p><div class="font-preset-grid"><button type="button" data-testid="font-card-cinzel" class="font-preset-card "><div class="font-card-header"><span class="font-name">Cinzel</span><span class="font-badge badge-royal">Royal Standard</span></div><div class="font-author">Natanael Gama / Google Fonts</div><div class="font-preview-sample" style="font-family:&#x27;Cinzel&#x27;, Georgia, &#x27;Prompt&#x27;, serif">CHARM OF TRANSITION 2026 — มนต์เสน่ห์แห่งรอยต่อฤดู</div><div class="font-desc">ฟอนต์โรมันคลาสสิก ลายเส้นทรงเกียรติยศ มาตรฐานเวทีประกวดระดับสากล</div></button><button type="button" data-testid="font-card-amoria" class="font-preset-card "><div class="font-card-header"><span class="font-name">Playfair Display</span><span class="font-badge badge-luxury">Modern Luxury</span></div><div class="font-author">Claus Eggers Sørensen / Google Fonts</div><div class="font-preview-sample" style="font-family:&#x27;Playfair Display&#x27;, &#x27;Cinzel&#x27;, &#x27;Prompt&#x27;, serif">CHARM OF TRANSITION 2026 — มนต์เสน่ห์แห่งรอยต่อฤดู</div><div class="font-desc">ฟอนต์สไตล์ High-Fashion โมเดิร์นหรูหรา ลายเส้นคมชัด สง่างามเหนือระดับ</div></button><button type="button" data-testid="font-card-verve" class="font-preset-card "><div class="font-card-header"><span class="font-name">Cinzel Decorative</span><span class="font-badge badge-heritage">Classic Heritage</span></div><div class="font-author">Natanael Gama / Google Fonts</div><div class="font-preview-sample" style="font-family:&#x27;Cinzel Decorative&#x27;, &#x27;Cinzel&#x27;, &#x27;Prompt&#x27;, serif">CHARM OF TRANSITION 2026 — มนต์เสน่ห์แห่งรอยต่อฤดู</div><div class="font-desc">ฟอนต์คลาสสิกวิจิตร ศิลปะลวดลายโบราณ เอกลักษณ์โดดเด่นสะกดทุกสายตา</div></button><button type="button" data-testid="font-card-outfit" class="font-preset-card "><div class="font-card-header"><span class="font-name">Outfit</span><span class="font-badge badge-modern">Modern Sans</span></div><div class="font-author">Outfit / Google Fonts</div><div class="font-preview-sample" style="font-family:&#x27;Outfit&#x27;, &#x27;Prompt&#x27;, sans-serif">CHARM OF TRANSITION 2026 — มนต์เสน่ห์แห่งรอยต่อฤดู</div><div class="font-desc">ฟอนต์โมเดิร์นคลีน ไร้หัว อ่านง่าย สบายตา ทันสมัยและกระชับ</div></button><button type="button" data-testid="font-card-custom" class="font-preset-card active"><div class="font-card-header"><span class="font-name">Custom WebFont</span><span class="font-badge badge-custom">กำหนดเอง</span></div><div class="font-author">ใช้งาน: X</div><div class="font-preview-sample" style="font-family:&#x27;X&#x27;, serif">CHARM OF TRANSITION 2026 — มนต์เสน่ห์แห่งรอยต่อฤดู</div><div class="font-desc">ปรับแต่งและใส่ฟอนต์ใหม่ตามต้องการผ่าน Google Fonts URL หรือ Custom Font Family</div></button></div><form class="custom-font-drawer" style="margin-top:16px"><h4 style="font-size:0.88rem;font-weight:600;color:#c084fc;margin-bottom:10px"><span class="ui-ico-label"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-settings" aria-hidden="true"><path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915"></path><circle cx="12" cy="12" r="3"></circle></svg>ตั้งค่าฟอนต์กำหนดเอง (Custom Font Settings)</span></h4><div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(240px, 1fr));gap:12px;margin-bottom:12px"><div><label style="display:block;font-size:0.75rem;color:#94a3b8;margin-bottom:4px">ชื่อฟอนต์ (Font Display Name)</label><input type="text" class="control-input" style="width:100%;padding:8px 12px;background:rgba(14, 18, 44, 0.7);border:1px solid rgba(192, 132, 252, 0.3);border-radius:6px;color:#fff;font-size:0.85rem" placeholder="เช่น Playfair Display" value="X"/></div><div><label style="display:block;font-size:0.75rem;color:#94a3b8;margin-bottom:4px">CSS Font Family (จำเป็น)</label><input type="text" required="" class="control-input" style="width:100%;padding:8px 12px;background:rgba(14, 18, 44, 0.7);border:1px solid rgba(192, 132, 252, 0.3);border-radius:6px;color:#fff;font-size:0.85rem" placeholder="เช่น &#x27;Playfair Display&#x27;, serif" value="&#x27;X&#x27;, serif"/></div><div><label style="display:block;font-size:0.75rem;color:#94a3b8;margin-bottom:4px">Google Fonts CSS URL (ตัวเลือก)</label><input type="url" class="control-input" style="width:100%;padding:8px 12px;background:rgba(14, 18, 44, 0.7);border:1px solid rgba(192, 132, 252, 0.3);border-radius:6px;color:#fff;font-size:0.85rem" placeholder="https://fonts.googleapis.com/..." value="https://fonts.googleapis.com/css2?family=X"/></div></div><div style="display:flex;align-items:center;gap:10px"><button type="submit" class="btn-primary" style="padding:8px 18px;font-size:0.85rem"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-save" aria-hidden="true"><path d="M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"></path><path d="M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7"></path><path d="M7 3v4a1 1 0 0 0 1 1h7"></path></svg> บันทึกฟอนต์กำหนดเอง</button></div></form></div><div class="control-section-group"><h3 class="group-title"><span class="group-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-crown" aria-hidden="true"><path d="M11.562 3.266a.5.5 0 0 1 .876 0L15.39 8.87a1 1 0 0 0 1.516.294L21.183 5.5a.5.5 0 0 1 .798.519l-2.834 10.246a1 1 0 0 1-.956.734H5.81a1 1 0 0 1-.957-.734L2.02 6.02a.5.5 0 0 1 .798-.519l4.276 3.664a1 1 0 0 0 1.516-.294z"></path><path d="M5 21h14"></path></svg></span><span>รูปแบบการหมุนคำสำคัญ (Word Spin Mode)</span></h3><div class="mode-selection-grid"><button type="button" class="mode-card active"><span class="mode-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-gallery-vertical" aria-hidden="true"><path d="M3 2h18"></path><rect width="18" height="12" x="3" y="6" rx="2"></rect><path d="M3 22h18"></path></svg></span><div class="mode-info"><span class="mode-name">Royal Vertical Spin</span><span class="mode-desc">คำเลื่อนผ่านแกนกลางแนวตั้งสไตล์ Royal Reel (แนะนำ)</span></div></button><button type="button" class="mode-card "><span class="mode-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-box" aria-hidden="true"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path><path d="m3.3 7 8.7 5 8.7-5"></path><path d="M12 22V12"></path></svg></span><div class="mode-info"><span class="mode-name">3D Perspective Spin</span><span class="mode-desc">คำหมุนบนระนาบ 3D มิติความลึกและ Blur</span></div></button><button type="button" class="mode-card "><span class="mode-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-orbit" aria-hidden="true"><path d="M20.341 6.484A10 10 0 0 1 10.266 21.85"></path><path d="M3.659 17.516A10 10 0 0 1 13.74 2.152"></path><circle cx="12" cy="12" r="3"></circle><circle cx="19" cy="5" r="2"></circle><circle cx="5" cy="19" r="2"></circle></svg></span><div class="mode-info"><span class="mode-name">Circular Orbital Words</span><span class="mode-desc">คำหมุนวนรอบศูนย์กลางก่อนล็อกกึ่งกลาง</span></div></button><button type="button" class="mode-card "><span class="mode-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-ribbon" aria-hidden="true"><path d="M12 11.22C11 9.997 10 9 10 8a2 2 0 0 1 4 0c0 1-.998 2.002-2.01 3.22"></path><path d="m12 18 2.57-3.5"></path><path d="M6.243 9.016a7 7 0 0 1 11.507-.009"></path><path d="M9.35 14.53 12 11.22"></path><path d="M9.35 14.53C7.728 12.246 6 10.221 6 7a6 5 0 0 1 12 0c-.005 3.22-1.778 5.235-3.43 7.5l3.557 4.527a1 1 0 0 1-.203 1.43l-1.894 1.36a1 1 0 0 1-1.384-.215L12 18l-2.679 3.593a1 1 0 0 1-1.39.213l-1.865-1.353a1 1 0 0 1-.203-1.422z"></path></svg></span><div class="mode-info"><span class="mode-name">Royal Ribbon Spin</span><span class="mode-desc">ริบบิ้นแก้วแสงประกายเลื่อนผ่านคำ</span></div></button></div></div><div class="control-section-group"><h3 class="group-title"><span class="group-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-timer" aria-hidden="true"><line x1="10" x2="14" y1="2" y2="2"></line><line x1="12" x2="15" y1="14" y2="11"></line><circle cx="12" cy="14" r="8"></circle></svg></span><span>รูปแบบการหยุดสุ่มคำ (Word Spin Stop Mode)</span></h3><p class="ui-group-hint">เลือกระหว่างการสุ่มและหยุดล็อกคำอัตโนมัติ หรือสุ่มต่อเนื่องจนกว่าจะกดปุ่มหยุด</p><div class="mode-selection-grid ui-mode-grid"><button type="button" data-testid="spin-stop-card-auto" class="mode-card "><span class="mode-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-hourglass" aria-hidden="true"><path d="M5 22h14"></path><path d="M5 2h14"></path><path d="M17 22v-4.172a2 2 0 0 0-.586-1.414L12 12l-4.414 4.414A2 2 0 0 0 7 17.828V22"></path><path d="M7 2v4.172a2 2 0 0 0 .586 1.414L12 12l4.414-4.414A2 2 0 0 0 17 6.172V2"></path></svg></span><div class="mode-info"><div class="ui-mode-head"><span class="mode-name ui-mode-name">หยุดอัตโนมัติ (Auto-Stop)</span><span class="ui-badge ui-badge--sky">ค่าเริ่มต้น</span></div><span class="mode-desc ui-mode-desc">หมุนตามเวลาที่กำหนด (4.5 วินาที) แล้วเริ่มชะลอหยุดและล็อกคำที่สุ่มได้อัตโนมัติ</span></div></button><button type="button" data-testid="spin-stop-card-manual" class="mode-card active"><span class="mode-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-octagon-x lucide-x-octagon" aria-hidden="true"><path d="m15 9-6 6"></path><path d="M2.586 16.726A2 2 0 0 1 2 15.312V8.688a2 2 0 0 1 .586-1.414l4.688-4.688A2 2 0 0 1 8.688 2h6.624a2 2 0 0 1 1.414.586l4.688 4.688A2 2 0 0 1 22 8.688v6.624a2 2 0 0 1-.586 1.414l-4.688 4.688a2 2 0 0 1-1.414.586H8.688a2 2 0 0 1-1.414-.586z"></path><path d="m9 9 6 6"></path></svg></span><div class="mode-info"><div class="ui-mode-head"><span class="mode-name ui-mode-name">หยุดด้วยตนเอง (Manual Stop)</span><span class="ui-badge ui-badge--red">ควบคุมสด</span></div><span class="mode-desc ui-mode-desc">คำหมุนต่อเนื่อง 60fps ไปเรื่อยๆ จนกว่าพิธีกร/แอดมินจะกดปุ่ม STOP หรือ Spacebar จึงจะเริ่มชะลอและล็อกคำ</span></div></button></div></div><div class="control-section-group"><h3 class="group-title"><span class="group-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-music" aria-hidden="true"><path d="M9 18V5l12-2v13"></path><circle cx="6" cy="18" r="3"></circle><circle cx="18" cy="16" r="3"></circle></svg></span><span>เพลง/เสียงประกอบช่วงสุ่มคำ (Word Spin Audio Track)</span></h3><p class="ui-group-hint">เลือกเพลงหรือเสียงระทึกช่วงสุ่มคำ สามารถอัปโหลดไฟล์เสียงใหม่ (MP3/WAV) หรือทดลองฟังเสียงได้ทันที</p><div style="background:rgba(14, 18, 44, 0.7);border:1px solid rgba(245, 158, 11, 0.25);border-radius:12px;padding:14px"><div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:8px"><div style="flex:1;min-width:220px"><label style="display:block;font-size:0.75rem;color:#cbd5e1;margin-bottom:4px">เสียงเพลงประจำช่วงสุ่ม (Spin Phase Audio)</label><select style="width:100%;padding:8px 12px;background:#0f172a;border:1px solid rgba(245, 158, 11, 0.4);border-radius:6px;color:#fff;font-size:0.85rem"><option value="">-- ไม่เปิดเพลง (ปิดเสียง) --</option><option value="preset-ambient-luxury">Royalty Ambient Pad (ประกายแสงราตรี)<!-- --> <!-- -->(เพลงระบบ)</option><option value="preset-spin-tension">Suspense Pulse (ลุ้นระทึกหมุนคำ)<!-- --> <!-- -->(เพลงระบบ)</option><option value="preset-question-focus">Focus Chrono Flow (สมาธิคิดคำตอบ)<!-- --> <!-- -->(เพลงระบบ)</option><option value="preset-fanfare-royal">Victory Crown Fanfare (เฉลิมฉลองชัยชนะ)<!-- --> <!-- -->(เพลงระบบ)</option><option value="custom-1" selected="">My Song<!-- --> <!-- -->(อัปโหลดเอง)</option></select></div><div style="display:flex;gap:8px;align-items:flex-end;margin-top:16px"><button type="button" class="btn-secondary" style="padding:8px 14px;font-size:0.82rem"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-play" aria-hidden="true"><path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"></path></svg> ฟังตัวอย่าง</button><input type="file" accept="audio/*" style="display:none"/><button type="button" class="btn-primary" style="padding:8px 14px;font-size:0.82rem;background:linear-gradient(135deg, #d97706, #b45309);border-color:#f59e0b"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-upload" aria-hidden="true"><path d="M12 3v12"></path><path d="m17 8-5-5-5 5"></path><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path></svg> อัปโหลดเสียงสุ่ม (MP3/WAV)</button><button type="button" class="btn-secondary btn-danger-soft" style="padding:8px 12px;font-size:0.82rem" title="ลบเพลงที่อัปโหลดนี้ออกจากระบบ"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash lucide-trash-2" aria-hidden="true"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg> ลบเพลง</button></div></div><div style="font-size:0.75rem;color:#94a3b8;display:flex;align-items:center;gap:8px;margin-top:4px"><span>ความยาว: <!-- -->125<!-- -->s</span><span>•</span><span class="ui-ico-label">สถานะ: <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-folder" aria-hidden="true"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg> ไฟล์เสียงที่อัปโหลดเอง</span></div></div></div><div class="control-section-group"><h3 class="group-title"><span class="group-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-gallery-vertical-end" aria-hidden="true"><path d="M7 2h10"></path><path d="M5 6h14"></path><rect width="18" height="12" x="3" y="10" rx="2"></rect></svg></span><span>ช่วงแสดงการ์ดคำที่สุ่มได้ (Selected Keyword Showcase)</span></h3><p class="ui-group-hint">เลือกว่าจะแสดงหน้าต่างการ์ดสรุปคำสำคัญที่สุ่มได้ (SELECTED KEYWORD) คั่นกลางก่อนเปิดการ์ดคำถามหรือไม่</p><div class="mode-selection-grid ui-mode-grid"><button type="button" data-testid="word-lock-card-on" class="mode-card "><span class="mode-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles lucide-stars" aria-hidden="true"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"></path><path d="M20 2v4"></path><path d="M22 4h-4"></path><circle cx="4" cy="20" r="2"></circle></svg></span><div class="mode-info"><div class="ui-mode-head"><span class="mode-name ui-mode-name">เปิดใช้งาน (ON)</span><span class="ui-badge ui-badge--sky">ค่าเริ่มต้น</span></div><span class="mode-desc ui-mode-desc">เมื่อหยุดสุ่ม จะแสดงการ์ดคำสำคัญเด่นชัดกลางจอก่อน 1.5 วินาที แล้วจึงเปิดการ์ดคำถาม</span></div></button><button type="button" data-testid="word-lock-card-off" class="mode-card active"><span class="mode-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-zap" aria-hidden="true"><path d="M15.914 4a1.5 1.5 0 00-2.474-1.561l-9 9A1.5 1.5 0 005.5 14h4.002a.5.5 0 01.471.666L8.086 20a1.5 1.5 0 002.475 1.56l9-9A1.5 1.5 0 0018.5 10h-3.997a.5.5 0 01-.472-.667z"></path></svg></span><div class="mode-info"><div class="ui-mode-head"><span class="mode-name ui-mode-name">ข้ามช่วงนี้ (OFF)</span><span class="ui-badge ui-badge--red">สตรีมกระชับ</span></div><span class="mode-desc ui-mode-desc">เมื่อหยุดสุ่ม จะข้ามไปเปิดการ์ดคำถามทันทีโดยไม่ต้องรอแสดงการ์ดคำคั่น</span></div></button></div></div><div class="control-section-group"><h3 class="group-title"><span class="group-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles lucide-stars" aria-hidden="true"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"></path><path d="M20 2v4"></path><path d="M22 4h-4"></path><circle cx="4" cy="20" r="2"></circle></svg></span><span>บรรยากาศเวทีและแสงสี (Atmospheric Layers &amp; FX)</span></h3><div class="toggles-grid"><label class="toggle-switch-card"><input type="checkbox" checked=""/><div class="toggle-card-content"><span class="toggle-title ui-ico-label"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-crown" aria-hidden="true"><path d="M11.562 3.266a.5.5 0 0 1 .876 0L15.39 8.87a1 1 0 0 0 1.516.294L21.183 5.5a.5.5 0 0 1 .798.519l-2.834 10.246a1 1 0 0 1-.956.734H5.81a1 1 0 0 1-.957-.734L2.02 6.02a.5.5 0 0 1 .798-.519l4.276 3.664a1 1 0 0 0 1.516-.294z"></path><path d="M5 21h14"></path></svg>เงาประกายมงกุฎ (Crown Silhouette)</span><span class="toggle-desc">แสดงลายน้ำมงกุฎคริสตัลโปร่งแสงกึ่งกลางเวที</span></div></label><label class="toggle-switch-card"><input type="checkbox" checked=""/><div class="toggle-card-content"><span class="toggle-title ui-ico-label"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-waves-horizontal lucide-waves" aria-hidden="true"><path d="M2 12q2.5 2 5 0t5 0 5 0 5 0"></path><path d="M2 19q2.5 2 5 0t5 0 5 0 5 0"></path><path d="M2 5q2.5 2 5 0t5 0 5 0 5 0"></path></svg>แสงสะท้อนผิวน้ำ (Water Reflection)</span><span class="toggle-desc">ผิวน้ำสะท้อนแสงไฟและเวทีที่ขอบจอด้านล่าง</span></div></label><label class="toggle-switch-card"><input type="checkbox" checked=""/><div class="toggle-card-content"><span class="toggle-title ui-ico-label"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles lucide-stars" aria-hidden="true"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"></path><path d="M20 2v4"></path><path d="M22 4h-4"></path><circle cx="4" cy="20" r="2"></circle></svg>ม่านแสงออโรร่า (Aurora Glow)</span><span class="toggle-desc">ริ้วคลื่นแสงสีน้ำเงิน-ม่วงพลิ้วไหว</span></div></label><label class="toggle-switch-card"><input type="checkbox" checked=""/><div class="toggle-card-content"><span class="toggle-title ui-ico-label"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-gem" aria-hidden="true"><path d="M10.5 3 8 9l4 13 4-13-2.5-6"></path><path d="M17 3a2 2 0 0 1 1.6.8l3 4a2 2 0 0 1 .013 2.382l-7.99 10.986a2 2 0 0 1-3.247 0l-7.99-10.986A2 2 0 0 1 2.4 7.8l2.998-3.997A2 2 0 0 1 7 3z"></path><path d="M2 9h20"></path></svg>ฝุ่นคริสตัลและโบเก้ (Floating Crystals)</span><span class="toggle-desc">ละอองประกายคริสตัลระยิบระยับลอยตัว</span></div></label></div></div><div class="control-section-group"><h3 class="group-title"><span class="group-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sliders-horizontal" aria-hidden="true"><path d="M10 5H3"></path><path d="M12 19H3"></path><path d="M14 3v4"></path><path d="M16 17v4"></path><path d="M21 12h-9"></path><path d="M21 19h-5"></path><path d="M21 5h-7"></path><path d="M8 10v4"></path><path d="M8 12H3"></path></svg></span><span>ความเข้มของแสงและอนุภาค (Density &amp; Glow Intensity)</span></h3><div class="sliders-panel"><div class="slider-row"><div class="slider-header"><span class="slider-label">ความหนาแน่นของคริสตัล (Crystal Density)</span><span class="slider-value">100<!-- -->%</span></div><input type="range" min="0.2" max="2.0" step="0.1" class="range-slider" value="1"/></div><div class="slider-row"><div class="slider-header"><span class="slider-label">ความสว่างของแสงออโรร่า (Glow Intensity)</span><span class="slider-value">100<!-- -->%</span></div><input type="range" min="0.2" max="2.0" step="0.1" class="range-slider" value="1"/></div></div><div class="section-reset-row" style="margin-top:16px"><button type="button" class="btn-secondary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-ccw" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg> รีเซ็ตค่าการแสดงผลเริ่มต้น</button></div></div></div>"`;

exports[`split panels render the same markup > MusicPanel (muted, manual) 1`] = `"<div class="ui-panel-stack"><div style="background:linear-gradient(135deg, rgba(28, 32, 70, 0.7), rgba(14, 18, 44, 0.85));border:1px solid rgba(255, 255, 255, 0.1);border-radius:16px;padding:1.25rem;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem"><div style="display:flex;align-items:center;gap:0.75rem"><div style="width:42px;height:42px;border-radius:10px;background:linear-gradient(135deg, var(--ctl-accent), #a855f7);display:flex;align-items:center;justify-content:center;color:#fff;box-shadow:0 4px 16px rgba(124, 58, 237, 0.35)"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-music" aria-hidden="true"><path d="M9 18V5l12-2v13"></path><circle cx="6" cy="18" r="3"></circle><circle cx="18" cy="16" r="3"></circle></svg></div><div><div style="font-size:1.05rem;font-weight:700;color:#f8fafc">ระบบควบคุมเพลงประกอบเวที (Stage Music Control)</div><div class="ui-caption">จัดการและเปิด-ปิดเพลง BGM ผูกกับสถานะเวทีอัตโนมัติ หรือเปิดเพลงอิสระ</div></div></div><div style="display:flex;align-items:center;gap:0.85rem;flex-wrap:wrap"><button style="display:flex;align-items:center;gap:0.45rem;padding:0.55rem 1rem;border-radius:9999px;border:1.5px solid rgba(255, 255, 255, 0.15);background:rgba(255, 255, 255, 0.05);color:#94a3b8;font-size:0.82rem;font-weight:700;cursor:pointer;box-shadow:none;transition:all 0.25s ease"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-radio" aria-hidden="true"><path d="M16.247 7.761a6 6 0 0 1 0 8.478"></path><path d="M19.075 4.933a10 10 0 0 1 0 14.134"></path><path d="M4.925 19.067a10 10 0 0 1 0-14.134"></path><path d="M7.753 16.239a6 6 0 0 1 0-8.478"></path><circle cx="12" cy="12" r="2"></circle></svg>เล่นเพลงตามสถานะเวทีอัตโนมัติ (Auto-Sync: <!-- -->OFF<!-- -->)</button><div style="display:flex;align-items:center;gap:0.5rem;background:rgba(0, 0, 0, 0.3);padding:0.4rem 0.8rem;border-radius:10px;border:1px solid rgba(255, 255, 255, 0.08)"><button style="background:none;border:none;color:#f87171;cursor:pointer;display:flex;align-items:center"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-volume-x" aria-hidden="true"><path d="M11 4.702a.7.7 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.7.7 0 0 0 11 19.298z"></path><path d="m16.5 14.5 5-5"></path><path d="m16.5 9.5 5 5"></path></svg></button><input type="range" min="0" max="1" step="0.05" style="width:80px;accent-color:#38bdf8" value="0.75"/><span style="font-size:0.75rem;color:#cbd5e1;min-width:32px">75<!-- -->%</span></div><button style="display:flex;align-items:center;gap:0.35rem;padding:0.55rem 0.9rem;background:rgba(239, 68, 68, 0.15);border:1px solid rgba(239, 68, 68, 0.35);border-radius:8px;color:#fca5a5;font-size:0.82rem;font-weight:600;cursor:pointer"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"></rect></svg> ดับเพลงทั้งหมด (Fade Out)</button></div></div><div style="background:linear-gradient(135deg, rgba(124, 58, 237, 0.15), rgba(14, 18, 44, 0.85));border:1.5px solid rgba(124, 58, 237, 0.35);border-radius:16px;padding:1.25rem;box-shadow:0 8px 32px rgba(0, 0, 0, 0.35)"><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.75rem"><div style="display:flex;align-items:center;gap:0.5rem"><span style="padding:0.2rem 0.6rem;border-radius:9999px;font-size:0.72rem;font-weight:700;text-transform:uppercase;background:rgba(255, 255, 255, 0.1);color:#94a3b8;border:1px solid rgba(255, 255, 255, 0.1)"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-pause lucide-pause-circle" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="10" x2="10" y1="15" y2="9"></line><line x1="14" x2="14" y1="15" y2="9"></line></svg> พักชั่วคราว (Paused / Idle)</span></div><div style="font-size:0.8rem;color:#94a3b8;font-family:monospace">00:00<!-- --> / <!-- -->00:00</div></div><div style="font-size:1.25rem;font-weight:800;color:#f8fafc;margin-bottom:0.2rem">ยังไม่มีเพลงที่กำลังเล่น</div><div style="font-size:0.82rem;color:#94a3b8;margin-bottom:1rem">เลือกเพลงจากรายการด้านล่างเพื่อเริ่มเล่น</div><div style="height:8px;width:100%;background:rgba(255, 255, 255, 0.1);border-radius:9999px;cursor:pointer;overflow:hidden;margin-bottom:1rem;position:relative"><div style="width:0%;height:100%;background:linear-gradient(90deg, var(--ctl-accent), #38bdf8);border-radius:9999px;transition:width 0.15s linear"></div></div><div style="display:flex;align-items:center;justify-content:center;gap:0.85rem"><button style="display:flex;align-items:center;gap:0.4rem;padding:0.65rem 1.4rem;background:linear-gradient(135deg, #22c55e, #16a34a);border:none;border-radius:10px;color:#fff;font-weight:700;cursor:pointer"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-play" aria-hidden="true"><path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"></path></svg> เล่นเพลง (Play)</button><button style="display:flex;align-items:center;gap:0.35rem;padding:0.65rem 1rem;background:rgba(255, 255, 255, 0.08);border:1px solid rgba(255, 255, 255, 0.15);border-radius:10px;color:#cbd5e1;cursor:pointer"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-ccw" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg> เริ่มใหม่ (Restart)</button></div></div><div style="background:rgba(14, 18, 44, 0.6);border:1px solid rgba(255, 255, 255, 0.08);border-radius:16px;padding:1.25rem"><div style="font-size:0.95rem;font-weight:700;color:#f8fafc;margin-bottom:0.35rem;display:flex;align-items:center;gap:0.4rem"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fde047" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles lucide-stars" aria-hidden="true"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"></path><path d="M20 2v4"></path><path d="M22 4h-4"></path><circle cx="4" cy="20" r="2"></circle></svg> กำหนดเพลงประจำช่วงเวที (Stage Phase Soundtracks)</div><div style="font-size:0.75rem;color:#94a3b8;margin-bottom:1rem">เมื่อเปิดใช้งาน Auto-Sync ระบบจะสลับมาเล่นเพลงที่ผูกไว้กับแต่ละช่วงอัตโนมัติ</div><div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(240px, 1fr));gap:0.85rem"><div style="background:rgba(0, 0, 0, 0.3);padding:0.9rem;border-radius:10px;border:1px solid rgba(56, 189, 248, 0.2)"><div style="font-size:0.82rem;font-weight:700;color:#38bdf8;margin-bottom:0.4rem"><span class="ui-ico-label"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" 